diff --git a/cmake/DreamAddGame.cmake b/cmake/DreamAddGame.cmake
index c8a2f79..4393f57 100644
--- a/cmake/DreamAddGame.cmake
+++ b/cmake/DreamAddGame.cmake
@@ -63,11 +63,19 @@ function(dream_add_game id)
       list(APPEND _units ${_gen}/${id}_part${k}.cpp)
     endforeach()
   endif()
-  string(REGEX MATCHALL "dest = 0x[0-9A-Fa-f]+" _dests "${_toml}")
+  # Each [[relocations]] block, in order. One with `file = "..."` is a code file the program loads
+  # from disc (SA-nx): it is a dependency of the translation and is split into 8 parts.
+  set(_extra_deps "")
+  string(REPLACE ";" "," _blocks "${_toml}")
+  string(REPLACE "[[relocations]]" ";" _blocks "${_blocks}")
+  list(POP_FRONT _blocks)
   set(_seen "")
-  foreach(d IN LISTS _dests)
-    string(REGEX REPLACE "dest = 0x" "" d "${d}")
-    string(TOLOWER "${d}" d)
+  foreach(_b IN LISTS _blocks)
+    string(REGEX MATCH "dest[ \t]*=[ \t]*0x([0-9A-Fa-f]+)" _dm "${_b}")
+    if(NOT CMAKE_MATCH_1)
+      continue()
+    endif()
+    string(TOLOWER "${CMAKE_MATCH_1}" d)
     # Several [[relocations]] may share a destination (overlays: the same address holding different
     # code at different times). Their later units are named _2, _3, ... exactly as
     # `dream-translate game` names them, or the build would expect files it never produces.
@@ -83,6 +91,13 @@ function(dream_add_game id)
     endif()
     list(APPEND _units ${_gen}/${id}_reloc_${d}.cpp)
     list(APPEND _headers ${_gen}/${id}_reloc_${d}.h)
+    string(REGEX MATCH "file[ \t]*=[ \t]*\"([^\"]+)\"" _fm "${_b}")
+    if(CMAKE_MATCH_1)
+      list(APPEND _extra_deps ${_dir}/${CMAKE_MATCH_1})
+      foreach(k RANGE 1 7)
+        list(APPEND _units ${_gen}/${id}_reloc_${d}_part${k}.cpp)
+      endforeach()
+    endif()
   endforeach()
 
   # A symbol table only names the emitted functions, so it is optional: a title with no Ghidra
@@ -98,7 +113,7 @@ function(dream_add_game id)
     OUTPUT ${_units} ${_headers}
     COMMAND dream-translate game --config ${_toml_path} --out-dir ${_gen}
             --parts ${DREAM_TRANSLATE_PARTS} ${DREAM_TRANSLATE_EXTRA_FLAGS}
-    DEPENDS dream-translate ${_toml_path} ${_symbols} ${_bin}
+    DEPENDS dream-translate ${_toml_path} ${_symbols} ${_bin} ${_extra_deps}
     COMMENT "Translating ${ARG_TITLE}"
     VERBATIM)
 
