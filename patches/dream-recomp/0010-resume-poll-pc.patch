+namespace {
+// Records the pc of every poll and switches polling off, so a body runs through once.
+struct PollRecorder : dream::sh4::Hooks {
+    std::vector<std::uint32_t> pcs;
+    void on_poll(Ctx& c, dream::Memory&) override {
+        pcs.push_back(c.pc);
+        c.next_event = ~std::uint64_t{0};
+    }
+    void on_trapa(Ctx&, dream::Memory&, std::uint32_t) override { FAIL("trapa"); }
+    void on_rte(Ctx&, dream::Memory&) override { FAIL("rte"); }
+    void on_untranslated(Ctx&, dream::Memory&, std::uint32_t t) override {
+        FAIL("untranslated " << t);
+    }
+};
+}  // namespace
+
+TEST_CASE("p13_tailpr: an interrupt polled on a resume records the resume pc") {
+    // A task switch taken at that poll re-enters the body at c.pc. Recording the entry instead ran
+    // the prologue a second time on a frame that was already built (Sonic Adventure, patch 0010).
+    dream::BareMemory m;
+    load_image(m, "p13_tailpr.bin", 0x8C040000);
+    Ctx c = fresh();
+    c.pr = 0x8C00FFF0;
+    c.r[1] = 10;
+    const std::uint32_t sp = c.r[15];
+    // The frame _main built before its bsr: PR saved, then resumed at the call's return address.
+    c.r[15] = sp - 4;
+    m.write32(c.r[15], 0x8C00FFF0);
+    c.next_event = 0;  // an interrupt is due
+    PollRecorder rec;
+    dream::sh4::set_hooks(&rec);
+    dream::sh4::resume_at(c, m, 0x8C040006);
+    dream::sh4::set_hooks(nullptr);
+    REQUIRE_FALSE(rec.pcs.empty());
+    CHECK(rec.pcs.front() == 0x8C040006u);
+    CHECK(c.r[1] == 12u);  // only the epilogue ran (+2): no second pass through the body
+    CHECK(c.r[15] == sp);
+}
