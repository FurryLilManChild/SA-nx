diff --git a/runtime/tests/test_memory.cpp b/runtime/tests/test_memory.cpp
index 73668a1..c12552c 100644
--- a/runtime/tests/test_memory.cpp
+++ b/runtime/tests/test_memory.cpp
@@ -247,3 +247,36 @@ TEST_CASE("memory: the main RAM fast path keeps every size, mirror and write wat
     CHECK(seen[0] == 0x8C002004u);
     CHECK(seen[1] == 0xAC002008u);
 }
+
+TEST_CASE("memory: writes to video memory are reported as page runs") {
+    // SA-nx: the renderer drops textures decoded from video memory the guest has rewritten.
+    DcMemory m;
+    std::vector<std::pair<std::uint32_t, std::uint32_t>> runs;
+    const auto take = [&] {
+        runs.clear();
+        m.take_vram_writes([&](std::uint32_t b, std::uint32_t e) { runs.emplace_back(b, e); });
+    };
+    take();
+    CHECK(runs.empty());
+    m.write32(0xA4140000u, 1u);  // 64-bit view: offset 0x140000
+    m.write16(0xA4141FFEu, 2u);  // the next page
+    m.write32(0xA4300010u, 3u);  // somewhere else
+    take();
+    REQUIRE(runs.size() == 2);
+    CHECK(runs[0] == std::make_pair(0x140000u, 0x142000u));
+    CHECK(runs[1] == std::make_pair(0x300000u, 0x301000u));
+    take();
+    CHECK(runs.empty());  // taken once
+    // A store-queue burst straight into video memory counts too (QACR area 1, 0x04000000).
+    m.set_qacr(0, 1u << 2);
+    m.sq_write32(0xE0000000u, 7u);
+    m.sq_flush(0xE0050000u);
+    take();
+    REQUIRE(runs.size() == 1);
+    CHECK(runs[0].first == 0x050000u);
+    // Main RAM does not.
+    m.write32(0x8C010000u, 9u);
+    take();
+    CHECK(runs.empty());
+}
