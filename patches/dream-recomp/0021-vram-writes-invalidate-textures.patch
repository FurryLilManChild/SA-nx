@@ -5,6 +5,7 @@
 // log shows what it touched.
 #pragma once
 
+#include <algorithm>
 #include <cstdint>
 #include <functional>
 #include <memory>
@@ -101,6 +102,44 @@ public:
 
     std::uint8_t* ram() noexcept { return ram_.get(); }
     std::uint8_t* vram() noexcept { return vram_.get(); }
+
+    // SA-nx: video memory written since the last take_vram_writes(), in 4 KB pages, so the
+    // renderer's texture cache can drop what it decoded from bytes that have changed since. A
+    // movie rewrites the same two textures every frame; without this the cache kept showing the
+    // first two frames it decoded. Every path that writes video memory (store, write64,
+    // sq_flush; DMA goes through store) reports here.
+    static constexpr unsigned kVramPageShift = 12;
+    void note_vram_write(const std::uint8_t* p, std::uint32_t bytes) noexcept {
+        const std::uintptr_t off = reinterpret_cast<std::uintptr_t>(p) -
+                                   reinterpret_cast<std::uintptr_t>(vram_.get());
+        if (off >= kVramSize || bytes == 0)
+            return;
+        const std::uintptr_t last = std::min<std::uintptr_t>(off + bytes - 1, kVramSize - 1);
+        for (std::uintptr_t page = off >> kVramPageShift; page <= (last >> kVramPageShift); ++page)
+            vram_dirty_[page >> 6] |= 1ull << (page & 63u);
+        vram_dirty_any_ = true;
+    }
+    // Calls `fn(begin, end)` once per run of written pages, as byte offsets into video memory
+    // (the 64-bit view, which is how textures are addressed), and forgets them.
+    template <typename F>
+    void take_vram_writes(F&& fn) {
+        if (!vram_dirty_any_)
+            return;
+        vram_dirty_any_ = false;
+        constexpr std::uint32_t pages = kVramSize >> kVramPageShift;
+        std::uint32_t run = pages;  // first page of the current run, or none
+        for (std::uint32_t page = 0; page <= pages; ++page) {
+            const bool dirty =
+                page < pages && ((vram_dirty_[page >> 6] >> (page & 63u)) & 1u) != 0;
+            if (dirty && run == pages)
+                run = page;
+            if (!dirty && run != pages) {
+                fn(run << kVramPageShift, page << kVramPageShift);
+                run = pages;
+            }
+        }
+        for (auto& w : vram_dirty_) w = 0;
+    }
     std::uint8_t* aram() noexcept { return aram_.get(); }
     std::uint8_t* bios() noexcept { return bios_.get(); }
     std::uint8_t* flash() noexcept { return flash_.get(); }
@@ -234,6 +273,8 @@ private:
     MmioHandler* find(const std::vector<Range>& t, std::uint32_t a) const noexcept;
 
     std::unique_ptr<std::uint8_t[]> ram_, vram_, aram_, bios_, flash_, ocram_;
