+namespace {
+// SA-nx: --hide-file NAME. Changes the last character of NAME's ISO9660 directory record in every
+// sector read, so the game cannot open that file (Sonic Adventure's intro movie, for testing). The
+// changed name sorts where the original did, so lookups of every other file are unaffected.
+class HidingDisc final : public dream::gdrom::Disc {
+public:
+    HidingDisc(std::unique_ptr<dream::gdrom::Disc> inner, std::vector<std::string> names)
+        : inner_(std::move(inner)), names_(std::move(names)) {
+        tracks_ = inner_->tracks();
+        type_ = inner_->type();
+        path_ = inner_->path();
+    }
+    bool read_raw(std::uint32_t lba, std::uint8_t* out) override {
+        if (!inner_->read_raw(lba, out))
+            return false;
+        const dream::gdrom::Track* t = track_for(lba);
+        const std::size_t n = t ? t->sector_size : 2048;
+        for (const auto& name : names_) {
+            const std::string rec = name + ";1";
+            for (std::size_t i = 0; i + rec.size() <= n; ++i)
+                if (std::memcmp(out + i, rec.data(), rec.size()) == 0) {
+                    ++out[i + name.size() - 1];
+                    ++hidden;
+                }
+        }
+        return true;
+    }
+    std::size_t hidden = 0;
+
+private:
+    std::unique_ptr<dream::gdrom::Disc> inner_;
+    std::vector<std::string> names_;
+};
+}  // namespace
