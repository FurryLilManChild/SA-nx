diff --git a/render/shaders/oit_common.glsl b/render/shaders/oit_common.glsl
new file mode 100644
index 0000000..cc295fb
--- /dev/null
+++ b/render/shaders/oit_common.glsl
@@ -0,0 +1,40 @@
+// Per-pixel translucency (SA-nx). Declarations shared by the gather and resolve passes.
+//
+// The PowerVR sorts translucent surfaces per pixel ("auto sort", ISP_FEED_CFG bit 0 clear), which
+// a per-strip sort cannot reproduce: a small decal (Sonic's iris) sits on a larger strip (the eye
+// white) whose nearest corner is nearer than the decal, so the strip sorts after it and covers
+// it. Instead every translucent fragment that passes its depth test is appended to a list for its
+// pixel, and the resolve pass sorts each list by depth and blends it, back to front.
+
+layout(push_constant) uniform Push {
+    vec2 scale;
+    vec2 offset;
+    int mode;  // as geometry.frag; gather also: bits 7-9 depth mode, 10-12 src, 13-15 dst instr
+    float alpha_ref;
+    uint width;     // pixels per row of the list heads
+    uint capacity;  // fragments the node buffer holds
+    uint poly;      // submission order of the polygon, to break depth ties
+}
+push;
+
+struct Node {
+    uint colour;  // packUnorm4x8
+    float depth;  // pvr_depth(): larger is nearer
+    uint info;    // bits 0-2 src instr, 3-5 dst instr, 6-31 submission order
+    uint next;    // index of the next node for this pixel, 0xFFFFFFFF at the end
+};
+
+layout(set = 1, binding = 0) buffer Counter {
+    uint count;
+}
+counter;
+layout(set = 1, binding = 1) buffer Heads {
+    uint heads[];
+};
+layout(set = 1, binding = 2) buffer Nodes {
+    Node nodes[];
+};
+layout(set = 1, binding = 3) uniform sampler2D opaque_depth;
+layout(set = 1, binding = 4) uniform sampler2D opaque_colour;
+
+const uint kEnd = 0xFFFFFFFFu;
diff --git a/render/shaders/oit_gather.frag b/render/shaders/oit_gather.frag
new file mode 100644
index 0000000..69d6924
--- /dev/null
+++ b/render/shaders/oit_gather.frag
@@ -0,0 +1,46 @@
+// Translucent gather pass (SA-nx): shade, test against the opaque depth, append to the pixel's
+// list. Nothing is written to the colour attachment; oit_resolve.frag does the blending.
+#version 450
+#extension GL_GOOGLE_include_directive : require
+
+layout(set = 0, binding = 0) uniform sampler2D tex;
+
+layout(location = 0) in vec4 v_base;
+layout(location = 1) in vec4 v_offset;
+layout(location = 2) in vec3 v_uv;
+
+#include "oit_common.glsl"
+#include "shade.glsl"
+
+// The hardware's eight depth comparisons, in its own order, new value against stored value. The
+// fixed-function test is not used here: a fragment that fails it would still have appended
+// itself, since the shader writes gl_FragDepth and so runs before the late depth test.
+bool depth_passes(int m, float d, float stored) {
+    switch (m) {
+        case 0: return false;
+        case 1: return d < stored;
+        case 2: return d == stored;
+        case 3: return d <= stored;
+        case 4: return d > stored;
+        case 5: return d != stored;
+        case 6: return d >= stored;
+        default: return true;
+    }
+}
+
+void main() {
+    const vec4 colour = clamp(shade_fragment(), 0.0, 1.0);
+    const float d = pvr_depth(v_uv.z);
+    const ivec2 p = ivec2(gl_FragCoord.xy);
+    if (!depth_passes((push.mode >> 7) & 7, d, texelFetch(opaque_depth, p, 0).r))
+        discard;
+    const uint i = atomicAdd(counter.count, 1u);
+    if (i >= push.capacity)
+        discard;  // out of room: this fragment is lost, the rest of the frame is not
+    const uint slot = uint(p.y) * push.width + uint(p.x);
+    const uint prev = atomicExchange(heads[slot], i);
+    nodes[i].colour = packUnorm4x8(colour);
+    nodes[i].depth = d;
+    nodes[i].info = (uint(push.mode >> 10) & 63u) | (push.poly << 6);
+    nodes[i].next = prev;
+}
diff --git a/render/shaders/oit_resolve.frag b/render/shaders/oit_resolve.frag
new file mode 100644
index 0000000..f3bf4ab
--- /dev/null
+++ b/render/shaders/oit_resolve.frag
@@ -0,0 +1,90 @@
+// Translucent resolve pass (SA-nx): sort each pixel's fragments by depth and blend them over the
+// opaque image, back to front, with the hardware's blend instructions.
+#version 450
+#extension GL_GOOGLE_include_directive : require
+
+#include "oit_common.glsl"
+
+layout(location = 0) out vec4 o_colour;
+
+// Fragments kept per pixel. Past this many the farthest are dropped, which costs the least.
+const int kMax = 32;
+
+// The hardware's eight blend factors. 2 and 3 are "the other colour": the destination for the
+// source factor, the source for the destination factor.
+vec4 factor(uint code, vec4 src, vec4 dst, bool is_src) {
+    const vec4 other = is_src ? dst : src;
+    switch (code) {
+        case 0u: return vec4(0.0);
+        case 1u: return vec4(1.0);
+        case 2u: return other;
+        case 3u: return vec4(1.0) - other;
+        case 4u: return vec4(src.a);
+        case 5u: return vec4(1.0 - src.a);
+        case 6u: return vec4(dst.a);
+        default: return vec4(1.0 - dst.a);
+    }
+}
+
+// Drawn first is the farther (smaller 1/w); at equal depth the earlier submitted.
+bool before(float da, uint oa, float db, uint ob) {
+    return da < db || (da == db && oa < ob);
+}
+
+void main() {
+    const ivec2 p = ivec2(gl_FragCoord.xy);
+    vec4 dst = texelFetch(opaque_colour, p, 0);
+
+    uint idx[kMax];
+    float dep[kMax];
+    uint ord[kMax];
+    int n = 0;
+    uint i = heads[uint(p.y) * push.width + uint(p.x)];
+    // Bounded, so a damaged list cannot hang the GPU.
+    for (int guard = 0; i != kEnd && guard < 4096; ++guard) {
+        const float d = nodes[i].depth;
+        const uint o = nodes[i].info >> 6;
+        if (n < kMax) {
+            idx[n] = i;
+            dep[n] = d;
+            ord[n] = o;
+            ++n;
+        } else {
+            // Full: replace the farthest kept fragment if this one is nearer.
+            int far = 0;
+            for (int k = 1; k < kMax; ++k)
+                if (before(dep[k], ord[k], dep[far], ord[far]))
+                    far = k;
+            if (before(dep[far], ord[far], d, o)) {
+                idx[far] = i;
+                dep[far] = d;
+                ord[far] = o;
+            }
+        }
+        i = nodes[i].next;
+    }
+    // Insertion sort, farthest first.
+    for (int a = 1; a < n; ++a) {
+        const uint ti = idx[a];
+        const float td = dep[a];
+        const uint to = ord[a];
+        int b = a - 1;
+        while (b >= 0 && before(td, to, dep[b], ord[b])) {
+            idx[b + 1] = idx[b];
+            dep[b + 1] = dep[b];
+            ord[b + 1] = ord[b];
+            --b;
+        }
+        idx[b + 1] = ti;
+        dep[b + 1] = td;
+        ord[b + 1] = to;
+    }
+    for (int k = 0; k < n; ++k) {
+        const vec4 src = unpackUnorm4x8(nodes[idx[k]].colour);
+        const uint info = nodes[idx[k]].info;
+        dst = clamp(src * factor(info & 7u, src, dst, true) +
+                        dst * factor((info >> 3) & 7u, src, dst, false),
+                    0.0, 1.0);
+    }
+    o_colour = dst;
+}
diff --git a/render/shaders/oit_resolve.vert b/render/shaders/oit_resolve.vert
new file mode 100644
index 0000000..cfb192e
--- /dev/null
+++ b/render/shaders/oit_resolve.vert
@@ -0,0 +1,7 @@
+// Full-screen triangle for the translucent resolve pass (SA-nx).
+#version 450
+
+void main() {
+    const vec2 p = vec2(float((gl_VertexIndex << 1) & 2), float(gl_VertexIndex & 2));
+    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
+}
diff --git a/render/shaders/shade.glsl b/render/shaders/shade.glsl
new file mode 100644
index 0000000..1fab091
--- /dev/null
+++ b/render/shaders/shade.glsl
@@ -0,0 +1,45 @@
+// Shading shared by the opaque pass (geometry.frag) and the translucent gather pass
+// (oit_gather.frag). The includer declares `push`, `tex` and the three inputs first.
+
+// The hardware's depth is 1/w; this spreads it over the depth buffer's precision the way the
+// PowerVR does. Both passes must compute it identically: the gather pass compares its own value
+// with what the opaque pass stored.
+float pvr_depth(float inv_w) {
+    const float w = 100000.0 * inv_w;
+    return log2(1.0 + max(w, -0.999999)) / 34.0;
+}
+
+// The polygon's colour before any blending: vertex colour, texture by the TSP shading
+// instruction, then the offset colour.
+vec4 shade_fragment() {
+    const float inv_w = v_uv.z;
+    vec4 base = v_base / inv_w;
+    vec4 offset_colour = v_offset / inv_w;
+    // "Use alpha" clear means the surface is opaque however its colours are encoded: the vertex
+    // alpha is data for something else and must not reach the blender. Crazy Taxi's title logo is
+    // in the translucent list with this clear on every polygon, and honouring the alpha instead
+    // blends the whole logo into the background.
+    if ((push.mode & 64) == 0)
+        base.a = 1.0;
+    vec4 colour = base;
+
+    if ((push.mode & 4) != 0) {
+        vec4 texel = texture(tex, v_uv.xy / inv_w);
+        if ((push.mode & 8) != 0)
+            texel.a = 1.0;
+        const int shading = push.mode & 3;
+        if (shading == 0) {  // decal
+            colour = vec4(texel.rgb, texel.a);
+        } else if (shading == 1) {  // modulate
+            colour = vec4(texel.rgb * base.rgb, texel.a);
+        } else if (shading == 2) {  // decal, blended by the texture's alpha
+            colour = vec4(mix(base.rgb, texel.rgb, texel.a), base.a);
+        } else {  // modulate, alphas multiplied
+            colour = vec4(texel.rgb * base.rgb, texel.a * base.a);
+        }
+    }
+    if ((push.mode & 16) != 0)
+        colour.rgb += offset_colour.rgb;
+
+    return colour;
+}
