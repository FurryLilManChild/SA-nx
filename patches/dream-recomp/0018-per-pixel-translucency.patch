+// Per-pixel translucency (SA-nx). The gather pipelines differ only in culling: depth is tested in
+// the shader against the opaque pass's depth, blending happens in the resolve.
+bool Renderer::prepare_oit(VkRenderPass pass) {
+    if (pass == oit_pass_ && resolve_pipeline_)
+        return true;
+    for (auto& [k, pl] : gather_pipelines_) vkDestroyPipeline(ctx_->device(), pl, nullptr);
+    gather_pipelines_.clear();
+    if (resolve_pipeline_) {
+        vkDestroyPipeline(ctx_->device(), resolve_pipeline_, nullptr);
+        resolve_pipeline_ = VK_NULL_HANDLE;
+    }
+    oit_pass_ = pass;
+    PipelineDesc d;
+    d.vs = resolve_vs_;
+    d.fs = resolve_fs_;
+    d.vertex_input = false;
+    d.depth_test = false;
+    d.pass = pass;
+    d.subpass = 1;
+    resolve_pipeline_ = build_pipeline(d);
+    return resolve_pipeline_ != VK_NULL_HANDLE;
+}
+
+VkPipeline Renderer::gather_pipeline(std::uint32_t cull_mode) {
+    if (auto it = gather_pipelines_.find(cull_mode); it != gather_pipelines_.end())
+        return it->second;
+    PipelineDesc d;
+    d.vs = vs_;
+    d.fs = gather_fs_;
+    d.cull = cull_flags(cull_mode);
+    d.depth_test = false;
+    d.colour_write = false;
+    d.pass = oit_pass_;
+    d.subpass = 0;
+    VkPipeline pl = build_pipeline(d);
+    if (pl)
+        gather_pipelines_.emplace(cull_mode, pl);
+    return pl;
+}
+
+void Renderer::draw_resolve(VkCommandBuffer cmd) {
+    if (!resolve_pipeline_ || !oit_set_)
+        return;
+    vkCmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, resolve_pipeline_);
+    vkCmdBindDescriptorSets(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, layout_, 1, 1, &oit_set_, 0,
+                            nullptr);
+    PushConstants push{};
+    push.oit_width = oit_width_;
+    push.oit_capacity = oit_capacity_;
+    vkCmdPushConstants(cmd, layout_, VK_SHADER_STAGE_VERTEX_BIT | VK_SHADER_STAGE_FRAGMENT_BIT, 0,
+                       sizeof push, &push);
+    vkCmdDraw(cmd, 3, 1, 0, 0);
+}
