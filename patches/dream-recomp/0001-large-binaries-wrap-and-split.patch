+        const std::size_t share = total / options.parts + 1;
+        std::vector<std::ostringstream> parts(options.parts);
+        for (auto& p : parts) p << prelude;
+        std::size_t k = 0, used = 0;
+        for (auto& b : bodies) {
+            if (used >= share && k + 1 < options.parts) {
