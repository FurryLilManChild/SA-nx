+            src << fe.run() << "\n";
+        }
+    } else {
+        // Every part starts with the same prelude (includes and every declaration), then takes a
+        // contiguous share of the bodies, balanced by emitted size.
+        const std::string prelude = src.str();
+        std::vector<std::string> bodies;
+        bodies.reserve(specs.size());
+        std::size_t total = 0;
+        for (const auto& f : specs) {
+            FunctionEmitter fe(image, f, options, known, summaries, result);
+            fe.set_written(&written);
+            bodies.push_back(fe.run());
+            total += bodies.back().size() + 1;
