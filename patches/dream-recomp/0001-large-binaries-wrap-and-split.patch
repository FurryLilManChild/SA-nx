+                used = 0;
+            }
+            parts[k] << b << "\n";
+            used += b.size() + 1;
+        }
+        src.str("");
+        src << parts[0].str();
+        for (unsigned i = 1; i < options.parts; ++i) {
+            parts[i] << "}  // namespace dream::gen\n";
+            result.extra_sources.push_back(parts[i].str());
+        }
     }
     src << "namespace {\n";
     if (options.overlay) {
