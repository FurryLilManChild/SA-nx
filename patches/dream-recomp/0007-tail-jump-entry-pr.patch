+TEST_CASE("p13_tailpr: a bra into a shared epilogue returns locally, not non-locally") {
+    // Called directly, not through run_guest: run_guest recovers from a NonLocalReturn and the
+    // results come out right either way, which is how the false non-local return went unnoticed.
+    // Here a throw fails the test. The epilogue's rts goes to the caller's PR, which differs from
+    // the PR at the jump (the inner call's return address), so it is only local if the jumping
+    // function's entry PR was handed over.
+    dream::BareMemory m;
+    load_image(m, "p13_tailpr.bin", 0x8C040000);
+    Ctx c = fresh();
+    c.pr = 0x8C00FFF0;
+    c.r[1] = 10;
+    const std::uint32_t sp = c.r[15];
+    CHECK_NOTHROW(dream::gen::tailpr_main(c, m));
+    CHECK(c.r[1] == 13u);
+    CHECK(c.pr == 0x8C00FFF0u);
+    CHECK(c.r[15] == sp);
+    // Nothing is left for the next prologue to take.
+    CHECK_FALSE(dream::sh4::g_tail_entry_set);
+    // The same through a computed jump: jmp @r2 goes through call_indirect.
+    Ctx c2 = fresh();
+    c2.pr = 0x8C00FFF0;
+    c2.r[1] = 10;
+    CHECK_NOTHROW(dream::gen::tailpr_main2(c2, m));
+    CHECK(c2.r[1] == 13u);
+    CHECK(c2.pr == 0x8C00FFF0u);
+    CHECK(c2.r[15] == sp);
+    CHECK_FALSE(dream::sh4::g_tail_entry_set);
+}
