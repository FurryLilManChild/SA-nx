diff --git a/tests/sh4/programs/p13_tailpr.s b/tests/sh4/programs/p13_tailpr.s
new file mode 100644
index 0000000..f55c22b
--- /dev/null
+++ b/tests/sh4/programs/p13_tailpr.s
@@ -0,0 +1,35 @@
+! A function that saves PR, calls, then jumps (bra) into a shared epilogue that discovery keeps as
+! a function of its own. At the jump PR still holds the inner call's return address; the epilogue
+! restores the caller's PR and returns there. That `rts` is an ordinary return, not a non-local
+! one: Sonic Adventure's movie player does this on every frame, and treating it as non-local threw
+! and resumed the whole call chain each time. r1 counts: inner adds 1, the epilogue adds 2.
+! _main2 does the same through a computed jump (jmp @r2), which goes through call_indirect.
+! Hand-encoded (p13_tailpr.bin, 36 bytes), checked with `dream-translate disasm`.
+	.text
+	.global _main
+	.global _inner
+	.global _tail
+	.global _main2
+_main:
+	sts.l	pr,@-r15
+	bsr	_inner
+	nop
+	bra	_tail
+	nop
+_inner:
+	rts
+	add	#1,r1
+_tail:
+	lds.l	@r15+,pr
+	rts
+	add	#2,r1
+_main2:
+	sts.l	pr,@-r15
+	bsr	_inner
+	nop
+	mov.l	.Ltail,r2
+	jmp	@r2
+	nop
+	.align 2
+.Ltail:
+	.long	_tail
