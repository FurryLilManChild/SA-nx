index 0837731..02897e6 100644
--- a/runtime/include/dream/runtime/sh4/abi.h
+++ b/runtime/include/dream/runtime/sh4/abi.h
@@ -62,6 +62,30 @@ void call_indirect(Ctx& c, ::dream::Memory& m, std::uint32_t target);
 // run_guest runs the program from `entry` until control returns to the PR it was started with,
 // re-entering translated code through resume_at after every non-local return.
 [[noreturn]] void nonlocal_return(Ctx& c, ::dream::Memory& m, std::uint32_t pc);
+
+// SA-nx: a tail jump (bra, bt/bf, a fall-through into another function, or a computed jmp/braf;
+// discovery keeps shared epilogues as functions of their own) leaves PR at whatever the last call
+// set, not at the address the jumping function must return to. The callee would take that stale
+// PR as its entry PR and treat its own correct `rts` as a non-local return. Emitted code hands the
+// jumping function's entry PR over, with the target, immediately before the jump; a prologue takes
+// it only when the target is its own entry, so a handoff that lands in a runtime hook or the
+// interpreter cannot leak into a later, unrelated prologue. Taking always clears it.
+inline thread_local bool g_tail_entry_set = false;
+inline thread_local std::uint32_t g_tail_entry_pr = 0;
+inline thread_local std::uint32_t g_tail_entry_target = 0;
+inline void set_tail_entry_pr(std::uint32_t pr, std::uint32_t target) noexcept {
+    g_tail_entry_pr = pr;
+    g_tail_entry_target = target & 0x1FFFFFFFu;
+    g_tail_entry_set = true;
+}
+inline std::uint32_t take_entry_pr(const Ctx& c, std::uint32_t self) noexcept {
+    if (g_tail_entry_set) {
+        g_tail_entry_set = false;
+        if (g_tail_entry_target == (self & 0x1FFFFFFFu))
+            return g_tail_entry_pr;
+    }
+    return c.pr;
+}
 void resume_at(Ctx& c, ::dream::Memory& m, std::uint32_t pc);
 void resume_miss(Ctx& c, ::dream::Memory& m, std::uint32_t pc);
 void run_guest(Ctx& c, ::dream::Memory& m, std::uint32_t entry);
