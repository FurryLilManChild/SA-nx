+// SA-nx: a computed jump (jmp/braf), not a call. A function entry is tail-called; an address inside
+// a translated function is a non-local transfer (run_guest resumes there; calling its resume entry
+// nested would leave the jumping code's callers to run that code a second time); anything else
+// goes to the untranslated handler as call_indirect does.
+void jump_indirect(Ctx& c, ::dream::Memory& m, std::uint32_t target);
 
 // Non-local returns (docs/emitter-design.md, "Non-local returns"). Emitted code calls
 // nonlocal_return from an `rts` whose target is not its entry PR; it throws NonLocalReturn.
diff --git a/runtime/src/sh4/abi_bare.cpp b/runtime/src/sh4/abi_bare.cpp
index d19b486..b900b12 100644
--- a/runtime/src/sh4/abi_bare.cpp
+++ b/runtime/src/sh4/abi_bare.cpp
@@ -359,6 +359,22 @@ void call_indirect(Ctx& c, ::dream::Memory& m, std::uint32_t target) {
     throw std::runtime_error("untranslated call target " + hex(target) + " from pc " + hex(c.pc));
 }
 
+void jump_indirect(Ctx& c, ::dream::Memory& m, std::uint32_t target) {
+    if (GuestFn fn = find_function(target, &m)) {
+        fn(c, m);
+        return;
+    }
+    const std::uint32_t phys = target & 0x1FFFFFFFu;
+    if (!interpreted(phys)) {
+        if (const FunctionEntry* e = find_containing(target, &m); e && e->resume) {
+            g_tail_entry_set = false;
+            nonlocal_return(c, m, target);
+        }
+    }
+    g_tail_entry_set = false;
+    call_indirect(c, m, target);
+}
