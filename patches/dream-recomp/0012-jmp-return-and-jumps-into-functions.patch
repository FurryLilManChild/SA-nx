+TEST_CASE("p13_tailpr: a jmp to the return address is a return, run once") {
+    // _jret returns through `jmp @r0` to _main3's call return, which lies inside _main3. Taken as
+    // a tail call, that re-entered _main3 there as a second activation and then the first one
+    // ran the same tail again: r1 would gain 4 twice and the stack would be popped twice.
+    dream::BareMemory m;
+    load_image(m, "p13_tailpr.bin", 0x8C040000);
+    Ctx c = fresh();
+    c.pr = 0x8C00FFF0;
+    c.r[1] = 10;
+    const std::uint32_t sp = c.r[15];
+    CHECK_NOTHROW(dream::gen::tailpr_main3(c, m));
+    CHECK(c.r[1] == 15u);
+    CHECK(c.pr == 0x8C00FFF0u);
+    CHECK(c.r[15] == sp);
+}
