+_main3:
+	sts.l	pr,@-r15
+	bsr	_jret
+	nop
+	add	#4,r1
+	lds.l	@r15+,pr
+	rts
+	nop
+	nop
+_jret:
+	sts.l	pr,@-r15
+	add	#1,r1
+	mov.l	@r15+,r0
+	jmp	@r0
