diff --git a/runtime/tests/test_memory.cpp b/runtime/tests/test_memory.cpp
index 08ba01e..73668a1 100644
--- a/runtime/tests/test_memory.cpp
+++ b/runtime/tests/test_memory.cpp
@@ -216,3 +216,34 @@ TEST_CASE("memory: a device write marks the journal as one that cannot be undone
     // The device write is not in the journal, so undoing cannot silently half-revert it.
     CHECK(m.journal.size() == 1);
 }
+
+TEST_CASE("memory: the main RAM fast path keeps every size, mirror and write watch") {
+    // SA-nx: loads and stores to area 3 skip resolve(). They must still land in the same bytes,
+    // in every access size, through every mirror, and stores must still reach the write watch.
+    DcMemory m;
+    m.write32(0x8C001000u, 0x11223344u);
+    CHECK(m.read32(0x0C001000u) == 0x11223344u);
+    CHECK(m.read32(0xAC001000u) == 0x11223344u);
+    CHECK(m.read32(0x0D001000u) == 0x11223344u);  // 16 MB mirror
+    CHECK(m.read32(0x0F001000u) == 0x11223344u);  // last mirror of area 3
+    CHECK(m.read16(0x8C001002u) == 0x1122u);
+    CHECK(m.read8(0x8C001003u) == 0x11u);
+    m.write16(0xAC001000u, 0xBEEFu);
+    m.write8(0x0C001002u, 0x77u);
+    CHECK(m.read32(0x8C001000u) == 0x1177BEEFu);
+    // Not main RAM: area 1 (VRAM) and area 7 (P4 store queue window) still go the general way.
+    m.write32(0xA5000000u, 0xCAFEF00Du);
+    CHECK(m.read32(0xA5000000u) == 0xCAFEF00Du);
+    CHECK(m.read32(0x8C000000u) != 0xCAFEF00Du);
+
+    std::vector<std::uint32_t> seen;
+    m.watch_lo = 0x0C002000u;
+    m.watch_hi = 0x0C002010u;
+    m.on_watch_write = [&](std::uint32_t addr, std::uint32_t, unsigned) { seen.push_back(addr); };
+    m.write32(0x8C002004u, 1u);
+    m.write8(0xAC002008u, 2u);
+    m.write32(0x8C003000u, 3u);  // outside the watch
+    REQUIRE(seen.size() == 2);
+    CHECK(seen[0] == 0x8C002004u);
+    CHECK(seen[1] == 0xAC002008u);
+}
