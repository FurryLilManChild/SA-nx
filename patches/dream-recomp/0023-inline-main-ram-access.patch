+    std::uint32_t watch_lo = 1, watch_hi = 0;
+
+protected:
+    virtual std::uint8_t do_read8(std::uint32_t addr) = 0;
+    virtual std::uint16_t do_read16(std::uint32_t addr) = 0;
+    virtual std::uint32_t do_read32(std::uint32_t addr) = 0;
+    virtual std::uint64_t do_read64(std::uint32_t addr) = 0;
+    virtual void do_write8(std::uint32_t addr, std::uint8_t v) = 0;
+    virtual void do_write16(std::uint32_t addr, std::uint16_t v) = 0;
+    virtual void do_write32(std::uint32_t addr, std::uint32_t v) = 0;
+    virtual void do_write64(std::uint32_t addr, std::uint64_t v) = 0;
+
+    // The implementation's main RAM, mirrored every (fast_ram_mask_ + 1) bytes across area 3;
+    // null keeps every access on the virtual path.
+    std::uint8_t* fast_ram_ = nullptr;
+    std::uint32_t fast_ram_mask_ = 0;
+
+private:
+    // Area 3 seen through P0 to P3: physical = a & 0x1FFFFFFF, area = physical >> 26. P4
+    // (0xE0000000 and above) is on-chip and never RAM.
+    DREAM_ALWAYS_INLINE const std::uint8_t* fast_load(std::uint32_t a) const noexcept {
+        if (fast_ram_ && a < 0xE0000000u && ((a >> 26) & 7u) == 3u)
+            return fast_ram_ + (a & fast_ram_mask_);
+        return nullptr;
+    }
+    DREAM_ALWAYS_INLINE std::uint8_t* fast_store(std::uint32_t a) const noexcept {
+        if (fast_ram_ && a < 0xE0000000u && ((a >> 26) & 7u) == 3u && !journaling &&
+            !hash_writes && !(watch_lo < watch_hi))
+            return fast_ram_ + (a & fast_ram_mask_);
+        return nullptr;
+    }
+    template <typename T>
+    DREAM_ALWAYS_INLINE T fast_read(std::uint32_t a, T (Memory::*slow)(std::uint32_t)) {
+        if (const std::uint8_t* p = fast_load(a)) {
+            T v;
+            std::memcpy(&v, p, sizeof v);
+            return v;
+        }
+        return (this->*slow)(a);
+    }
+    template <typename T>
+    DREAM_ALWAYS_INLINE void fast_write(std::uint32_t a, T v, void (Memory::*slow)(std::uint32_t, T)) {
+        if (std::uint8_t* p = fast_store(a)) {
+            std::memcpy(p, &v, sizeof v);
+            return;
+        }
+        (this->*slow)(a, v);
+    }
 };
 
