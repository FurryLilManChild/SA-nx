diff --git a/runtime/tests/test_memory.cpp b/runtime/tests/test_memory.cpp
index c12552c..e421cda 100644
--- a/runtime/tests/test_memory.cpp
+++ b/runtime/tests/test_memory.cpp
@@ -280,3 +280,25 @@ TEST_CASE("memory: writes to video memory are reported as page runs") {
     CHECK(runs.empty());
 }
 
+
+TEST_CASE("memory: the inline path through Memory& matches the device path") {
+    // SA-nx: emitted code holds a Memory&. Main RAM is served inline from it, everything else
+    // reaches DcMemory, and an armed write hash sends every store down the full path again.
+    DcMemory dc;
+    dream::Memory& m = dc;
+    m.write64(0x8C004000u, 0x0102030405060708ull);
+    CHECK(m.read64(0xAC004000u) == 0x0102030405060708ull);
+    CHECK(dc.ram()[0x4000] == 0x08);  // the same bytes DcMemory owns
+    m.write32(0xA5000100u, 0x12345678u);  // VRAM: not area 3, so DcMemory's path
+    CHECK(m.read32(0xA5000100u) == 0x12345678u);
+
+    dc.hash_writes = true;
+    const std::uint64_t before = dc.writes_hashed;
+    m.write32(0x8C004010u, 1u);
+    m.write8(0x8C004014u, 2u);
+    CHECK(dc.writes_hashed == before + 2);  // both stores reached the hash
+    dc.hash_writes = false;
+    m.write32(0x8C004018u, 3u);
+    CHECK(dc.writes_hashed == before + 2);  // and the inline path is back once it is off
+    CHECK(m.read32(0x8C004018u) == 3u);
+}
