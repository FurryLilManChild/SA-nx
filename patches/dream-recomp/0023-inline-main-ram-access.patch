diff --git a/runtime/tests/test_memory.cpp b/runtime/tests/test_memory.cpp
index c12552c..604ee9e 100644
--- a/runtime/tests/test_memory.cpp
+++ b/runtime/tests/test_memory.cpp
@@ -280,3 +280,55 @@ TEST_CASE("memory: writes to video memory are reported as page runs") {
     CHECK(runs.empty());
 }
 
+
+TEST_CASE("memory: the inline path through Memory& matches the device path") {
+    // SA-nx: emitted code holds a Memory&. Main RAM is served inline from it, everything else
+    // reaches DcMemory, and an armed write hash sends every store down the full path again.
+    DcMemory dc;
+    dream::Memory& m = dc;
+    m.write64(0x8C004000u, 0x0102030405060708ull);
+    CHECK(m.read64(0xAC004000u) == 0x0102030405060708ull);
+    CHECK(dc.ram()[0x4000] == 0x08);  // the same bytes DcMemory owns
+    m.write32(0xA5000100u, 0x12345678u);  // VRAM: not area 3, so DcMemory's path
+    CHECK(m.read32(0xA5000100u) == 0x12345678u);
+
+    dc.hash_writes = true;
+    const std::uint64_t before = dc.writes_hashed;
+    m.write32(0x8C004010u, 1u);
+    m.write8(0x8C004014u, 2u);
+    CHECK(dc.writes_hashed == before + 2);  // both stores reached the hash
+    dc.hash_writes = false;
+    m.write32(0x8C004018u, 3u);
+    CHECK(dc.writes_hashed == before + 2);  // and the inline path is back once it is off
+    CHECK(m.read32(0x8C004018u) == 3u);
+}
+
+TEST_CASE("memory: store-queue words written by the quick path reach RAM on the flush") {
+    // SA-nx: do_write32 and do_write64 put store-queue words straight into the queue when nothing
+    // watches stores. Both queues, both widths, then a flush to RAM through QACR, must give the
+    // same bytes as before; with the write hash armed the full path still runs and sees them.
+    DcMemory m;
+    dream::Memory& mem = m;
+    m.set_qacr(0, 0x0Cu);  // area 3 (RAM): bits 4:2 = 3
+    m.set_qacr(1, 0x0Cu);
+    for (unsigned q = 0; q < 2; ++q) {
+        const std::uint32_t base = 0xE0000000u + q * 32u;
+        mem.write64(base, 0x1111111100000000ull + q);
+        mem.write32(base + 8, 0x22220000u + q);
+        mem.write32(base + 12, 0x33330000u + q);
+        mem.write64(base + 16, 0x5555555544444444ull);
+        mem.write64(base + 24, 0x7777777766666666ull);
+        m.sq_flush(0xE0001000u + q * 32u);
+        const std::uint32_t ram = 0x8C001000u + q * 32u;
+        CHECK(m.read32(ram) == q);
+        CHECK(m.read32(ram + 4) == 0x11111111u);
+        CHECK(m.read32(ram + 8) == 0x22220000u + q);
+        CHECK(m.read32(ram + 12) == 0x33330000u + q);
+        CHECK(m.read32(ram + 16) == 0x44444444u);
+        CHECK(m.read32(ram + 28) == 0x77777777u);
+    }
+    m.hash_writes = true;
+    const std::uint64_t before = m.writes_hashed;
+    mem.write32(0xE0000000u, 9u);
+    CHECK(m.writes_hashed == before + 1);  // the full path, which reports to the hash
+}
