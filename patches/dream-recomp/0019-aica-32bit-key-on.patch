diff --git a/runtime/tests/test_mixer.cpp b/runtime/tests/test_mixer.cpp
index d269d4f..e0fa5d3 100644
--- a/runtime/tests/test_mixer.cpp
+++ b/runtime/tests/test_mixer.cpp
@@ -120,3 +120,26 @@ TEST_CASE("mixer: identical inputs give identical output") {
         REQUIRE(a.aica.last_left == b.aica.last_left);
     }
 }
+
+TEST_CASE("mixer: a 32-bit register write keys a channel on, from either CPU") {
+    // SA-nx: the registers are 16 bits on a 32-bit stride and drivers write whole words.
+    for (bool from_arm : {false, true}) {
+        Rig r;
+        r.square_wave(0x1000, 64, 8000);
+        r.program_channel(0x1000, 64);
+        const std::uint32_t on = r.ctrl | (1u << 14) | (1u << 15);
+        if (from_arm)
+            r.aica.arm_reg_write(0x00, on, 4);
+        else
+            r.w(0x00, on, 4);
+        CHECK(r.aica.mixer.key_ons == 1);
+        CHECK(r.aica.mixer.active_channels() == 1);
+        for (int i = 0; i < 2000; ++i) r.aica.sample_tick();
+        CHECK(r.aica.mixer.nonzero_samples > 1000);
+        if (from_arm)
+            r.aica.arm_reg_write(0x00, r.ctrl | (1u << 15), 4);
+        else
+            r.w(0x00, r.ctrl | (1u << 15), 4);
+        CHECK(r.aica.mixer.key_offs == 1);
+    }
+}
