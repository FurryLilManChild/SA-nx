+// SA-nx: with the sound thread running, the batch event takes the SH-4 line from what the thread
+// last published (no lock), and SH-4 register writes still change the line at once.
+TEST_CASE("aica: threaded, the SH-4 line follows the published state") {
+    Rig r;
+    using A = dream::aica::Aica;
+    r.aica.start_thread();
+    REQUIRE(r.aica.threaded());
+    r.aica.write(A::kRegBase + A::kMcieb, A::kIntSampleDone, 4);
+    // Enabling SAMPLE_DONE while it is pending raises the line on the SH-4's side immediately.
+    bool raised = false;
+    for (int i = 0; i < 200 && !raised; ++i) {
+        r.sys.sched.advance(A::kSh4CyclesPerSample * A::kThreadBatch);
+        raised = r.sys.holly.raised(dream::holly::Irq::AicaIrq);
+        if (!raised)
+            std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    CHECK(raised);
+    // Disabling it clears the line at the write, and batches after it keep it clear.
+    r.aica.write(A::kRegBase + A::kMcieb, 0, 4);
+    CHECK_FALSE(r.sys.holly.raised(dream::holly::Irq::AicaIrq));
+    for (int i = 0; i < 20; ++i) {
+        r.sys.sched.advance(A::kSh4CyclesPerSample * A::kThreadBatch);
+        CHECK_FALSE(r.sys.holly.raised(dream::holly::Irq::AicaIrq));
+    }
+    // Enabled again: the thread's next samples publish it and a batch event raises it.
+    r.aica.write(A::kRegBase + A::kMcire, A::kIntSampleDone, 4);  // clear pending first
+    r.aica.write(A::kRegBase + A::kMcieb, A::kIntSampleDone, 4);
+    raised = false;
+    for (int i = 0; i < 200 && !raised; ++i) {
+        r.sys.sched.advance(A::kSh4CyclesPerSample * A::kThreadBatch);
+        raised = r.sys.holly.raised(dream::holly::Irq::AicaIrq);
+        if (!raised)
+            std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    CHECK(raised);
+    r.aica.stop_thread();
+}
