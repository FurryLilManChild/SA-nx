+        const double gpu_ms = static_cast<double>(offscreen.wait_ns - perf_gpu_at) / 1e6;
+        const double present_ms = static_cast<double>(perf_present_ns) / 1e6;
+        const double sleep_ms = static_cast<double>(perf_sleep_ns) / 1e6;
+        const double paused_ms = static_cast<double>(perf_paused_ns) / 1e6;
+        const double audio_ms =
