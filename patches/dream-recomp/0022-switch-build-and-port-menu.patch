+        const double speed = static_cast<double>(guest_cycles - perf_cycles_at) / 200e6 / (wall - paused_ms / 1000.0);
+        const auto pct = [ms](double v) { return 100.0 * v / ms; };
+        // The GPU wait now falls inside render or present, wherever the pixels were first needed.
+        std::printf("perf: %.1f fps shown, %.1f renders/s, speed %.2fx | game %.0f%%, sound %.0f%%, "
