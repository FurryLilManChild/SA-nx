+std::uint32_t Renderer::load_pipelines(const std::string& path) {
+    pipeline_cache_path_ = path;
+    std::vector<char> data;
+    if (std::FILE* f = std::fopen(path.c_str(), "rb")) {
+        std::fseek(f, 0, SEEK_END);
+        const long size = std::ftell(f);
+        std::fseek(f, 0, SEEK_SET);
+        if (size > 0) {
+            data.resize(static_cast<std::size_t>(size));
+            if (std::fread(data.data(), 1, data.size(), f) != data.size())
+                data.clear();
+        }
+        std::fclose(f);
+    }
+    VkPipelineCacheCreateInfo ci{};
+    ci.sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO;
+    ci.initialDataSize = data.size();
+    ci.pInitialData = data.empty() ? nullptr : data.data();
+    // The driver checks the header and ignores data from another driver or GPU.
+    if (vkCreatePipelineCache(ctx_->device(), &ci, nullptr, &pipeline_cache_) != VK_SUCCESS) {
+        ci.initialDataSize = 0;
+        ci.pInitialData = nullptr;
+        if (vkCreatePipelineCache(ctx_->device(), &ci, nullptr, &pipeline_cache_) != VK_SUCCESS)
+            pipeline_cache_ = VK_NULL_HANDLE;
+    }
+    std::uint32_t built = 0;
+    if (std::FILE* f = std::fopen((path + ".keys").c_str(), "rb")) {
+        std::uint32_t bits = 0;
+        while (std::fread(&bits, sizeof bits, 1, f) == 1) {
+            PipelineKey key{};
+            key.depth_mode = bits & 7u;
+            key.depth_write = (bits >> 3) & 1u;
+            key.cull_mode = (bits >> 4) & 3u;
+            key.src_blend = (bits >> 6) & 7u;
+            key.dst_blend = (bits >> 9) & 7u;
+            key.blend = (bits >> 12) & 1u;
+            if (pipelines_.find(key) == pipelines_.end() && pipeline_for(key))
+                ++built;
+        }
+        std::fclose(f);
+    }
+    pipelines_dirty_ = false;  // what was just built is what the files already hold
+    return built;
+}
