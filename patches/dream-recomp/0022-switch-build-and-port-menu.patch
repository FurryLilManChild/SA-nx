+bool Offscreen::finish() {
+    if (!pending_)
+        return true;
+    pending_ = false;
+    // One second is far longer than any frame takes; waiting for ever would turn a lost device
+    // into a hung launcher with nothing on screen to say so.
+    const auto wait_from = std::chrono::steady_clock::now();
+    const VkResult waited = vkWaitForFences(ctx_->device(), 1, &fence_, VK_TRUE, finish_timeout_ns);
+    wait_ns += static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                              std::chrono::steady_clock::now() - wait_from)
+                                              .count());
+    if (waited != VK_SUCCESS) {
+        error_ = "the GPU did not finish the frame within a second";
+        return false;
+    }
+    readback_.invalidate();
+    have_pixels_ = true;
+    if (counted_) {
+        counted_ = false;
+        oit_count_out_.invalidate();
+        std::uint32_t words[4]{};
+        std::memcpy(words, oit_count_out_.mapped(), sizeof words);
+        const std::uint32_t n = words[0];
+        last_fragments_ = n;
+        counted_last_ = true;
+        stats.long_lists += words[1];
+        stats.unterminated += words[2];
+        stats.longest_walk = std::max(stats.longest_walk, words[3]);
+        stats.fragments += n;
+        stats.fragments_max = std::max(stats.fragments_max, n);
+        if (n > oit_capacity_)
+            stats.overflow_frames += 1;
+        stats.capacity = oit_capacity_;
+    }
+    if (timed_) {
+        timed_ = false;
+        std::uint64_t t[kStamps]{};
+        if (vkGetQueryPoolResults(ctx_->device(), queries_, 0, kStamps, sizeof t, t,
+                                  sizeof(std::uint64_t),
+                                  VK_QUERY_RESULT_64_BIT) == VK_SUCCESS) {
+            const auto ns = [this](std::uint64_t a, std::uint64_t b) {
+                return b > a ? static_cast<std::uint64_t>(static_cast<double>(b - a) *
+                                                          timestamp_period_)
+                             : 0u;
+            };
+            gpu.frames += 1;
+            gpu.total_ns += ns(t[0], t[4]);
+            gpu.opaque_ns += ns(t[0], t[1]);
+            gpu.gather_ns += ns(t[1], t[2]);
+            gpu.resolve_ns += ns(t[2], t[3]);
+            if (ns(t[2], t[3]) > kSlowResolveNs)
+                stats.slow_resolves += 1;  // counted for the log; nothing changes because of it
+        }
+    }
+    return true;
+}
