+                x[k] = std::clamp((v.x - geometry.left) * sx, 0.0f, w);
+                y[k] = std::clamp((v.y - geometry.top) * sy, 0.0f, h);
+            }
+            area += 0.5 * std::fabs(static_cast<double>((x[1] - x[0]) * (y[2] - y[0]) -
