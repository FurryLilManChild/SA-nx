new file mode 100644
index 0000000..3abc669
--- /dev/null
+++ b/render/src/port_menu.cpp
@@ -0,0 +1,244 @@
+// See port_menu.h.
+#include "dream/render/port_menu.h"
+
+#include <algorithm>
+#include <cstdlib>
+
+#include "dream/render/input_menu.h"
+#include "dream/render/overlay.h"
+
+namespace dream::render {
+
+namespace {
+
+std::string_view trim(std::string_view s) {
+    while (!s.empty() && (s.front() == ' ' || s.front() == '\t'))
+        s.remove_prefix(1);
+    while (!s.empty() && (s.back() == ' ' || s.back() == '\t' || s.back() == '\r'))
+        s.remove_suffix(1);
+    return s;
+}
+
+bool to_int(std::string_view s, int& out) {
+    if (s.empty() || s.size() > 9)
+        return false;
+    int v = 0;
+    bool neg = false;
+    std::size_t i = 0;
+    if (s[0] == '-') {
+        neg = true;
+        i = 1;
+    }
+    if (i == s.size())
+        return false;
+    for (; i < s.size(); ++i) {
+        if (s[i] < '0' || s[i] > '9')
+            return false;
+        v = v * 10 + (s[i] - '0');
+    }
+    out = neg ? -v : v;
+    return true;
+}
+
+template <std::size_t N>
+int step_index(const int (&steps)[N], int mhz) {
+    for (int i = 0; i < static_cast<int>(N); ++i)
+        if (steps[i] == mhz)
+            return i;
+    return 0;
+}
+
+}  // namespace
+
+std::string PortOptions::to_text() const {
+    std::string s;
+    s += "SHOW_FPS=" + std::string(show_fps ? "1" : "0") + "\n";
+    s += "SCREEN=" + std::string(screen == 1 ? "stretch" : "4:3") + "\n";
+    s += "VOLUME=" + std::to_string(volume) + "\n";
+    s += "CPU_MHZ=" + std::to_string(cpu_mhz) + "\n";
+    s += "GPU_MHZ=" + std::to_string(gpu_mhz) + "\n";
+    s += "MEM_MHZ=" + std::to_string(mem_mhz) + "\n";
+    s += "TRANSLUCENCY=" +
+         std::string(translucency == 1 ? "fast" : translucency == 2 ? "lean" : "accurate") + "\n";
+    return s;
+}
+
+PortOptions PortOptions::from_text(std::string_view text) {
+    PortOptions o;
+    while (!text.empty()) {
+        const std::size_t nl = text.find('\n');
+        std::string_view line = trim(text.substr(0, nl));
+        text = nl == std::string_view::npos ? std::string_view() : text.substr(nl + 1);
+        if (line.empty() || line[0] == '#')
+            continue;
+        const std::size_t eq = line.find('=');
+        if (eq == std::string_view::npos)
+            continue;
+        const std::string_view key = trim(line.substr(0, eq)), value = trim(line.substr(eq + 1));
+        int v = 0;
+        if (key == "SHOW_FPS" && to_int(value, v))
+            o.show_fps = v != 0;
+        else if (key == "SCREEN")
+            o.screen = value == "stretch" ? 1 : 0;
+        else if (key == "VOLUME" && to_int(value, v))
+            o.volume = std::clamp(v / 10 * 10, 0, 100);
+        else if (key == "CPU_MHZ" && to_int(value, v))
+            o.cpu_mhz = kCpuSteps[step_index(kCpuSteps, v)];  // not offered: stock
+        else if (key == "GPU_MHZ" && to_int(value, v))
+            o.gpu_mhz = kGpuSteps[step_index(kGpuSteps, v)];
+        else if (key == "MEM_MHZ" && to_int(value, v))
+            o.mem_mhz = kMemSteps[step_index(kMemSteps, v)];
+        else if (key == "TRANSLUCENCY")
+            o.translucency = value == "fast" ? 1 : value == "lean" ? 2 : 0;
+    }
+    return o;
+}
+
+void PortMenu::open(const PortOptions& o, bool can_set_clock) {
+    options_ = o;
+    clock_ = can_set_clock;
+    open_ = true;
+    dirty_ = false;
+    row_ = kResume;
+}
+
+void PortMenu::move(int delta) {
+    for (int tries = 0; tries < kRowCount; ++tries) {
+        row_ = (row_ + delta + kRowCount) % kRowCount;
+        if (visible(row_))
+            return;
+    }
+}
+
+void PortMenu::adjust(int delta) {
+    const PortOptions before = options_;
+    switch (row_) {
+        case kFps:
+            options_.show_fps = !options_.show_fps;
+            break;
+        case kScreen:
+            options_.screen = options_.screen == 1 ? 0 : 1;
+            break;
+        case kVolume:
+            options_.volume = std::clamp(options_.volume + delta * 10, 0, 100);
+            break;
+        case kTranslucency: {
+            // Shown in order of cost: accurate, accurate (lean), fast.
+            static constexpr int kOrder[] = {0, 2, 1};
+            int i = 0;
+            while (i < 3 && kOrder[i] != options_.translucency)
+                ++i;
+            i = ((i % 3) + (delta < 0 ? 2 : 1)) % 3;
+            options_.translucency = kOrder[i];
+            break;
+        }
+        case kCpu: {
+            const int n = static_cast<int>(std::size(kCpuSteps));
+            const int i = std::clamp(step_index(kCpuSteps, options_.cpu_mhz) + delta, 0, n - 1);
+            options_.cpu_mhz = kCpuSteps[i];
+            break;
+        }
+        case kMem: {
+            const int n = static_cast<int>(std::size(kMemSteps));
+            const int i = std::clamp(step_index(kMemSteps, options_.mem_mhz) + delta, 0, n - 1);
+            options_.mem_mhz = kMemSteps[i];
+            break;
+        }
+        case kGpu: {
+            const int n = static_cast<int>(std::size(kGpuSteps));
+            const int i = std::clamp(step_index(kGpuSteps, options_.gpu_mhz) + delta, 0, n - 1);
+            options_.gpu_mhz = kGpuSteps[i];
+            break;
+        }
+        default:
+            break;
+    }
+    if (!(options_ == before))
+        dirty_ = true;
+}
+
+PortMenu::Action PortMenu::activate() {
+    switch (row_) {
+        case kResume:
+            open_ = false;
+            return Action::Close;
+        case kControls:
+            open_ = false;
+            return Action::Controls;
+        case kQuit:
+            open_ = false;
+            return Action::Quit;
+        default:
+            adjust(1);  // A on a setting steps it, as on a console menu
+            return Action::None;
+    }
+}
+
+PortMenu::Action PortMenu::back() {
+    open_ = false;
+    return Action::Close;
+}
+
+void PortMenu::draw(std::uint32_t* rgba, unsigned pitch, unsigned width, unsigned height) const {
+    if (!open_ || !rgba || width == 0 || height == 0)
+        return;
+    const int w = static_cast<int>(width), h = static_cast<int>(height);
+    const unsigned s = std::max(1u, width / 320u);
+    const int line = static_cast<int>(text_height(s)) + static_cast<int>(s) * 2;
+    const int pad = static_cast<int>(s) * 6;
+
+    fill_rect(rgba, pitch, width, height, 0, 0, w, h, kUiShade);
+    int rows = 0;
+    for (int r = 0; r < kRowCount; ++r)
+        rows += visible(r) ? 1 : 0;
+    const int card_w = std::min(w - pad * 2, static_cast<int>(s) * 230);
+    const int card_h = std::min(h - pad * 2, line * (rows + 4) + pad * 3);
+    const int cx = (w - card_w) / 2, cy = (h - card_h) / 2;
+    fill_rect(rgba, pitch, width, height, cx, cy, card_w, card_h, kUiWhite);
+
+    const int banner_h = line + pad;
+    fill_rect(rgba, pitch, width, height, cx, cy, card_w, banner_h, kUiOrange);
+    const TextStyle banner{kUiWhite, 0, s};
+    draw_text(rgba, pitch, width, height, cx + pad, cy + pad / 2 + static_cast<int>(s),
+              "SONIC ADVENTURE", banner);
+
+    const int left = cx + pad, right = cx + card_w - pad;
+    int y = cy + banner_h + pad;
+    auto row = [&](int index, const std::string& name, const std::string& value) {
+        if (!visible(index))
+            return;
+        const bool sel = index == row_;
+        if (sel)
+            fill_rect(rgba, pitch, width, height, left - static_cast<int>(s) * 2,
+                      y - static_cast<int>(s), right - left + static_cast<int>(s) * 4, line,
+                      kUiOrange);
+        const TextStyle t{sel ? kUiWhite : kUiInk, 0, s};
+        draw_text(rgba, pitch, width, height, left, y, name, t);
+        if (!value.empty())
+            draw_text(rgba, pitch, width, height,
+                      right - static_cast<int>(text_width(value, s)), y, value, t);
+        y += line;
+    };
+    row(kResume, "RESUME", "");
+    row(kControls, "CONTROLS", "");
+    row(kFps, "SHOW FPS", options_.show_fps ? "< ON >" : "< OFF >");
+    row(kScreen, "SCREEN", options_.screen == 1 ? "< STRETCH >" : "< 4:3 >");
+    row(kVolume, "VOLUME", "< " + std::to_string(options_.volume) + "% >");
+    row(kTranslucency, "TRANSLUCENCY",
+        options_.translucency == 1   ? "< FAST >"
+        : options_.translucency == 2 ? "< LEAN >"
+                                     : "< ACCURATE >");
+    row(kCpu, "CPU CLOCK",
+        options_.cpu_mhz == 0 ? "< STOCK >" : "< " + std::to_string(options_.cpu_mhz) + " MHZ >");
+    row(kGpu, "GPU CLOCK",
+        options_.gpu_mhz == 0 ? "< STOCK >" : "< " + std::to_string(options_.gpu_mhz) + " MHZ >");
+    row(kMem, "MEMORY CLOCK",
+        options_.mem_mhz == 0 ? "< STOCK >" : "< " + std::to_string(options_.mem_mhz) + " MHZ >");
+    y += static_cast<int>(s) * 2;
+    row(kQuit, "QUIT GAME", "");
+
+    const TextStyle hint{kUiGrey, 0, s};
+    draw_text(rgba, pitch, width, height, left, cy + card_h - line, help, hint);
+}
+
+}  // namespace dream::render
