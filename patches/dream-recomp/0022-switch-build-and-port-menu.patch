+bool Renderer::save_pipelines() {
+    if (pipeline_cache_path_.empty() || !pipeline_cache_)
+        return false;
+    pipelines_dirty_ = false;
+    std::size_t size = 0;
+    if (vkGetPipelineCacheData(ctx_->device(), pipeline_cache_, &size, nullptr) != VK_SUCCESS)
+        return false;
+    std::vector<char> data(size);
+    if (size && vkGetPipelineCacheData(ctx_->device(), pipeline_cache_, &size, data.data()) !=
+                    VK_SUCCESS)
+        return false;
+    bool ok = true;
+    // Written whole each time, small files: the cache is some hundreds of kilobytes at most.
+    if (std::FILE* f = std::fopen(pipeline_cache_path_.c_str(), "wb")) {
+        ok = std::fwrite(data.data(), 1, size, f) == size;
+        std::fclose(f);
+    } else {
+        ok = false;
+    }
+    if (std::FILE* f = std::fopen((pipeline_cache_path_ + ".keys").c_str(), "wb")) {
+        for (const auto& [key, pipeline] : pipelines_) {
+            const std::uint32_t bits = key.bits();
+            ok = std::fwrite(&bits, sizeof bits, 1, f) == 1 && ok;
+        }
+        std::fclose(f);
+    } else {
+        ok = false;
+    }
+    return ok;
+}
