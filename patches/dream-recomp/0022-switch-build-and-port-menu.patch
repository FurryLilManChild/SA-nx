diff --git a/runtime/tests/test_gdrom.cpp b/runtime/tests/test_gdrom.cpp
index 0ac9967..38239a5 100644
--- a/runtime/tests/test_gdrom.cpp
+++ b/runtime/tests/test_gdrom.cpp
@@ -1,3 +1,7 @@
+#include <cstdio>
+#include <filesystem>
+#include <utility>
+#include <vector>
 #include <cstring>
 #include <string>
 
@@ -66,3 +70,54 @@ TEST_CASE("disc: unsupported and missing images report errors") {
     CHECK(open_disc("/nonexistent/x.chd", err) == nullptr);
     CHECK(!err.empty());
 }
+
+TEST_CASE("gdi: sectors read in any order match the track files byte for byte") {
+    // SA-nx: GdiDisc reads 64-sector windows. Sectors asked for out of order, across window edges,
+    // backwards and across tracks must still be exactly the bytes in the files.
+    namespace fs = std::filesystem;
+    const fs::path dir = fs::temp_directory_path() / "dream_gdi_window_test";
+    fs::create_directories(dir);
+    const auto byte_at = [](unsigned track, std::uint64_t i) {
+        return static_cast<std::uint8_t>((i * 131u + track * 7u + (i >> 9)) & 0xFFu);
+    };
+    const unsigned sizes[3] = {2352, 2352, 2352};
+    const unsigned counts[3] = {150, 10, 200};  // track 3 spans several windows
+    const unsigned lbas[3] = {0, 11000, 45000};
+    for (unsigned t = 0; t < 3; ++t) {
+        std::FILE* f = std::fopen((dir / ("track0" + std::to_string(t + 1) + ".bin")).string().c_str(), "wb");
+        REQUIRE(f != nullptr);
+        for (std::uint64_t i = 0; i < std::uint64_t(sizes[t]) * counts[t]; ++i)
+            std::fputc(byte_at(t, i), f);
+        std::fclose(f);
+    }
+    {
+        std::FILE* g = std::fopen((dir / "disc.gdi").string().c_str(), "w");
+        REQUIRE(g != nullptr);
+        std::fprintf(g, "3\n1 0 4 2352 track01.bin 0\n2 11000 0 2352 track02.bin 0\n"
+                        "3 45000 4 2352 track03.bin 0\n");
+        std::fclose(g);
+    }
+    std::string err;
+    auto disc = open_disc((dir / "disc.gdi").string(), err);
+    REQUIRE_MESSAGE(disc != nullptr, err);
+    std::vector<std::pair<unsigned, unsigned>> order;  // (track, sector)
+    for (unsigned s = 0; s < counts[2]; s += 37) order.push_back({2, s});
+    for (unsigned s = counts[2]; s-- > 0;) order.push_back({2, s});  // backwards
+    order.push_back({0, 149});
+    order.push_back({1, 3});
+    order.push_back({2, 63});
+    order.push_back({2, 64});
+    order.push_back({0, 0});
+    order.push_back({2, 199});
+    std::vector<std::uint8_t> sector(2352);
+    for (const auto& [t, s] : order) {
+        REQUIRE(disc->read_raw(lbas[t] + s, sector.data()));
+        bool same = true;
+        for (unsigned i = 0; same && i < 2352; ++i)
+            same = sector[i] == byte_at(t, std::uint64_t(s) * 2352 + i);
+        CHECK_MESSAGE(same, "track " << t + 1 << " sector " << s);
+    }
+    CHECK_FALSE(disc->read_raw(45000 + 200, sector.data()));  // past the end of track 3
+    disc.reset();
+    fs::remove_all(dir);
+}
