diff --git a/audio/src/sdl2_sink.cpp b/audio/src/sdl2_sink.cpp
new file mode 100644
index 0000000..cc03bf7
--- /dev/null
+++ b/audio/src/sdl2_sink.cpp
@@ -0,0 +1,78 @@
+// See sink.h. SA-nx: the Switch's playback, through devkitPro's switch-sdl2 (audren underneath),
+// which converts the AICA's 44.1 kHz to the console's 48 kHz. The same queue policy as the SDL3
+// sink: buffer a block, drop it when the device is too far behind, never block the guest.
+#include "dream/audio/sink.h"
+
+#include <SDL2/SDL.h>
+
+namespace dream::audio {
+
+Sink::~Sink() {
+    close();
+}
+
+bool Sink::open(unsigned rate) {
+    close();
+    rate_ = rate;
+    if (SDL_InitSubSystem(SDL_INIT_AUDIO) != 0) {
+        error_ = std::string("SDL_InitSubSystem(audio): ") + SDL_GetError();
+        return false;
+    }
+    SDL_AudioSpec want{}, have{};
+    want.freq = static_cast<int>(rate);
+    want.format = AUDIO_S16SYS;
+    want.channels = 2;
+    want.samples = 1024;
+    device_ = SDL_OpenAudioDevice(nullptr, 0, &want, &have, 0);
+    if (device_ == 0) {
+        error_ = std::string("SDL_OpenAudioDevice: ") + SDL_GetError();
+        return false;
+    }
+    SDL_PauseAudioDevice(device_, 0);
+    block_.reserve(kBlockFrames * 2);
+    return true;
+}
+
+void Sink::close() {
+    if (device_) {
+        SDL_CloseAudioDevice(device_);
+        device_ = 0;
+    }
+    block_.clear();
+}
+
+unsigned Sink::queued_samples() const {
+    if (!device_)
+        return 0;
+    return SDL_GetQueuedAudioSize(device_) / 4u;  // 16-bit stereo
+}
+
+void Sink::push(std::int16_t left, std::int16_t right) {
+    if (!device_)
+        return;
+    if (volume < 0.999f) {
+        left = static_cast<std::int16_t>(static_cast<float>(left) * volume);
+        right = static_cast<std::int16_t>(static_cast<float>(right) * volume);
+    }
+    block_.push_back(left);
+    block_.push_back(right);
+    ++pushed;
+    if (block_.size() < kBlockFrames * 2)
+        return;
+    if (queued_samples() > high_water) {
+        dropped += kBlockFrames;
+        block_.clear();
+        return;
+    }
+    flush();
+}
+
+void Sink::flush() {
+    if (!device_ || block_.empty())
+        return;
+    SDL_QueueAudio(device_, block_.data(), static_cast<Uint32>(block_.size() * sizeof(std::int16_t)));
+    ++blocks;
+    block_.clear();
+}
+
+}  // namespace dream::audio
