diff --git a/audio/tests/test_stretch.cpp b/audio/tests/test_stretch.cpp
new file mode 100644
index 0000000..e55e77a
--- /dev/null
+++ b/audio/tests/test_stretch.cpp
@@ -0,0 +1,99 @@
+// SA-nx: checks for the time-stretcher (stretch.h), no sound device needed.
+//   g++ -std=c++20 -O2 -Iaudio/include audio/tests/test_stretch.cpp -o test_stretch && ./test_stretch
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+#include "dream/audio/stretch.h"
+
+using dream::audio::Stretcher;
+
+namespace {
+int failures = 0;
+void check(bool ok, const char* what) {
+    std::printf("%s: %s\n", ok ? "ok  " : "FAIL", what);
+    if (!ok)
+        ++failures;
+}
+std::vector<std::int16_t> run(const std::vector<std::int16_t>& in, double ratio) {
+    Stretcher s;
+    std::vector<std::int16_t> out;
+    for (std::size_t i = 0; i < in.size(); i += 2) {
+        s.push(in[i], in[i + 1]);
+        if ((i / 2) % 512 == 511)
+            s.process(ratio, [&](const std::int16_t* p, std::size_t n) { out.insert(out.end(), p, p + n * 2); });
+    }
+    return out;
+}
+// Rising zero crossings per second of the left channel: the pitch of a sine.
+double pitch(const std::vector<std::int16_t>& s, std::size_t from) {
+    std::size_t n = 0;
+    for (std::size_t i = from + 2; i < s.size(); i += 2)
+        n += s[i - 2] < 0 && s[i] >= 0;
+    return static_cast<double>(n) * 44100.0 / static_cast<double>((s.size() - from) / 2);
+}
+// The longest run of near-silence (a gap) after the start.
+std::size_t longest_gap(const std::vector<std::int16_t>& s, std::size_t from) {
+    std::size_t run = 0, best = 0;
+    for (std::size_t i = from; i < s.size(); i += 2) {
+        run = std::abs(s[i]) < 50 ? run + 1 : 0;
+        best = std::max(best, run);
+    }
+    return best;
+}
+// The largest step between neighbouring samples of the left channel: a click shows as a jump far
+// beyond what the tone itself does (a 440 Hz sine at 15000 peaks at about 940 per sample).
+int largest_step(const std::vector<std::int16_t>& s, std::size_t from) {
+    int best = 0;
+    for (std::size_t i = from + 2; i < s.size(); i += 2)
+        best = std::max(best, std::abs(s[i] - s[i - 2]));
+    return best;
+}
+}  // namespace
+
+int main() {
+    // Two seconds of a 440 Hz tone with a slow beat, stereo.
+    std::vector<std::int16_t> tone;
+    for (int i = 0; i < 88200; ++i) {
+        const double t = i / 44100.0;
+        const double v = 12000.0 * std::sin(2 * M_PI * 440 * t) * (0.75 + 0.25 * std::sin(2 * M_PI * 3 * t));
+        tone.push_back(static_cast<std::int16_t>(v));
+        tone.push_back(static_cast<std::int16_t>(v * 0.8));
+    }
+    // Ratio 1: after the first hop (which fades in), the input comes back exactly.
+    {
+        const auto out = run(tone, 1.0);
+        bool same = out.size() > 40000;
+        for (std::size_t i = 1024; same && i < out.size(); ++i)
+            same = std::abs(out[i] - tone[i]) <= 1;
+        check(same, "ratio 1 passes the sound through unchanged");
+    }
+    for (double ratio : {1.18, 1.5, 2.0}) {
+        const auto out = run(tone, ratio);
+        const double len = static_cast<double>(out.size()) / static_cast<double>(tone.size());
+        const double p = pitch(out, 8192);
+        char what[160];
+        std::snprintf(what, sizeof what, "ratio %.2f: %.2fx as long, pitch %.1f Hz, longest gap %zu frames",
+                      ratio, len, p, longest_gap(out, 8192));
+        check(std::fabs(len - ratio) < 0.06 && std::fabs(p - 440.0) < 6.0 && longest_gap(out, 8192) < 8, what);
+    }
+    // The ratio changing every block, as it will while the game dips and recovers.
+    {
+        Stretcher st;
+        std::vector<std::int16_t> out;
+        for (std::size_t i = 0; i < tone.size(); i += 2) {
+            st.push(tone[i], tone[i + 1]);
+            if ((i / 2) % 512 == 511) {
+                const double r = 1.0 + 0.4 * (0.5 + 0.5 * std::sin(static_cast<double>(i) / 20000.0));
+                st.process(r, [&](const std::int16_t* p, std::size_t n) { out.insert(out.end(), p, p + n * 2); });
+            }
+        }
+        char what[160];
+        std::snprintf(what, sizeof what, "changing ratio: largest step %d (tone alone %d), longest gap %zu",
+                      largest_step(out, 2048), largest_step(tone, 0), longest_gap(out, 2048));
+        check(largest_step(out, 2048) < 1.3 * largest_step(tone, 0) && longest_gap(out, 2048) < 8, what);
+    }
+    std::printf("%s\n", failures ? "FAILED" : "all passed");
+    return failures ? 1 : 0;
+}
