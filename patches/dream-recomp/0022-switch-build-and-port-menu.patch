+bool Presenter::copy_from(VkCommandBuffer cmd, VkImage source, std::uint32_t width,
+                          std::uint32_t height) {
+    if (!ctx_ || !source || width == 0 || height == 0)
+        return false;
+    if (!ensure_image(width, height))
+        return false;
+    // The source was last written by the offscreen render pass (or its translucency pass), whose
+    // outgoing dependency already makes those writes visible to transfer reads later on the
+    // queue; this barrier only restates it, so the copy is correct on its own terms.
+    VkImageMemoryBarrier src{};
+    src.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+    src.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    src.newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    src.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    src.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    src.image = source;
+    src.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+    src.srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+    src.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+    VkImageMemoryBarrier dst = src;
+    dst.image = image_;
+    dst.oldLayout = uploaded_ ? VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL : VK_IMAGE_LAYOUT_UNDEFINED;
+    dst.newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    dst.srcAccessMask = uploaded_ ? VK_ACCESS_SHADER_READ_BIT : 0;
+    dst.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    const VkImageMemoryBarrier before[2] = {src, dst};
+    vkCmdPipelineBarrier(cmd,
+                         VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT |
+                             VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT,
+                         VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 2, before);
+    VkImageCopy ic{};
+    ic.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    ic.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    ic.extent = {width, height, 1};
+    vkCmdCopyImage(cmd, source, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, image_,
+                   VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &ic);
+    finish_transfer(cmd);
+    return true;
+}
