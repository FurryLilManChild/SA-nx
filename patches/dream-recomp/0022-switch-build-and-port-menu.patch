+struct IdleSkipStats {
+    std::uint64_t calls = 0;    // calls of the empty function
+    std::uint64_t skips = 0;    // of those, from a wait loop with time to skip
+    std::uint64_t cycles = 0;   // guest cycles skipped
+};
+
+// `function` must be an empty function in guest memory (rts; nop): checked here, and refused
+// with a reason in `error` otherwise. `callers` are the return addresses (PR) of its calls inside
+// wait loops. One function at a time; a second call replaces the first.
