+    return (hi << 32) | gld<std::uint32_t>(m, c, f, cyc, nev, a + 4);
+}
+DREAM_ALWAYS_INLINE void gst_pair(::dream::Memory& m, Ctx& c, const FastMem& f, std::uint64_t& cyc,
+                                  std::uint64_t& nev, std::uint32_t a, std::uint64_t v) {
+    gst<std::uint32_t>(m, c, f, cyc, nev, a, static_cast<std::uint32_t>(v >> 32));
+    gst<std::uint32_t>(m, c, f, cyc, nev, a + 4, static_cast<std::uint32_t>(v));
+}
+DREAM_ALWAYS_INLINE void gsq_flush(::dream::Memory& m, Ctx& c, std::uint64_t& cyc,
+                                   std::uint64_t& nev, std::uint32_t a) {
+    c.cycles = cyc;
+    m.sq_flush(a);
+    cyc = c.cycles;
+    nev = c.next_event;
+}
