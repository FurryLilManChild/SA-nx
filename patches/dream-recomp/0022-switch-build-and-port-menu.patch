+    gst_slow<T>(m, a, v);
+    cyc = c.cycles;
+    nev = c.next_event;
+}
+DREAM_ALWAYS_INLINE std::uint64_t gld_pair(::dream::Memory& m, Ctx& c, const FastMem& f,
+                                           std::uint64_t& cyc, std::uint64_t& nev,
+                                           std::uint32_t a) {
