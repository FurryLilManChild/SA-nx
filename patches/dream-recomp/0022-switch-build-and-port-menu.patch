index 0000000..8fb33d5
--- /dev/null
+++ b/tests/sh4/programs/p14_bank.s
@@ -0,0 +1,26 @@
+! SA-nx: a register-bank switch in the middle of a function (LDC Rm,SR and LDC.L @Rm+,SR that flip
+! SR.RB). With guest registers in host locals (EmitOptions::local_regs) the locals must be written
+! back before write_sr swaps r0-r7 with the other bank and read again after it, or r0 keeps the
+! value of the wrong bank. Encoded by hand (no SH toolchain in the session that added it); the
+! words are listed so the .bin can be checked.
+	.text
+	.global _bank
+_bank:
+	mov	#1,r0		! e001  bank A r0 = 1
+	stc	sr,r8		! 0802
+	mov	r8,r9		! 6983
+	mov	#0x20,r10	! ea20
+	shll16	r10		! 4a28
+	shll8	r10		! 4a18  r10 = SR.RB
+	xor	r10,r9		! 29aa  r9 = SR with RB flipped
+	ldc	r9,sr		! 490e  to bank B
+	mov	#5,r0		! e005  bank B r0 = 5
+	ldc	r8,sr		! 480e  back to bank A: r0 is 1 again
+	stc	r0_bank,r2	! 0282  r2 = bank B r0 = 5
+	mov.l	r9,@-r15	! 2f96
+	ldc.l	@r15+,sr	! 4f07  to bank B through memory
+	mov	#6,r0		! e006  bank B r0 = 6
+	ldc	r8,sr		! 480e  back to bank A
+	stc	r0_bank,r3	! 0382  r3 = 6
+	rts			! 000b
+	nop			! 0009
