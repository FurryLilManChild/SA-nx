 // registers produces output that follows the envelope, a noise channel produces output, the DSP
 // idles on an empty programme, and the mix is deterministic.
 #include <cstdint>
+#include <atomic>
+#include <chrono>
 #include <cstdlib>
+#include <thread>
+#include <vector>
 
 #include "dream/runtime/aica/aica.h"
 #include "dream/runtime/system.h"
@@ -143,3 +147,66 @@ TEST_CASE("mixer: a 32-bit register write keys a channel on, from either CPU") {
         CHECK(r.aica.mixer.key_offs == 1);
     }
 }
+
+TEST_CASE("aica thread: the sound processor on its own thread produces the same samples") {
+    // SA-nx: Aica::start_thread. Driven by the same virtual clock, the thread owes and produces
+    // the same number of samples, and a channel keyed on through the SH-4's registers sounds the
+    // same as on the SH-4's thread (the mixer and the ARM are the same code; only the thread
+    // changes). The thread may trail by up to kMaxLag samples, so the comparison is made after
+    // stop_thread(), which waits for nothing but ends the run where it stands: the clock is
+    // advanced in steps and the thread is allowed to catch up before each check.
+    Rig a, b;
+    for (Rig* r : {&a, &b}) {
+        r->square_wave(0x1000, 64, 8000);
+        r->program_channel(0x1000, 64);
+        r->key_on();
+    }
+    std::vector<std::int16_t> out_a, out_b;
+    a.aica.on_sample = [&](std::int16_t l, std::int16_t) { out_a.push_back(l); };
+    std::atomic<std::size_t> made_b{0};  // read while the thread runs; out_b only after it stops
+    b.aica.on_sample = [&](std::int16_t l, std::int16_t) {
+        out_b.push_back(l);
+        made_b.fetch_add(1);
+    };
+    b.aica.start_thread();
+    REQUIRE(b.aica.threaded());
+    // 64 batches of 32 samples: 2048 samples of guest time.
+    const std::uint64_t cycles = A::kSh4CyclesPerSample * A::kThreadBatch * 64;
+    a.sys.sched.advance(cycles);
+    b.sys.sched.advance(cycles);
+    // Let the thread finish what it is owed.
+    for (int spins = 0; spins < 2000 && made_b.load() < out_a.size(); ++spins)
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    b.aica.stop_thread();
+    CHECK_FALSE(b.aica.threaded());
+    // The threaded side counts a batch per event, starting one sample in (the first event fires
+    // after one sample's worth of cycles), so it may owe up to one batch fewer.
+    CHECK(out_b.size() + A::kThreadBatch >= out_a.size());
+    REQUIRE(out_b.size() > 1000);
+    const std::size_t n = std::min(out_a.size(), out_b.size());
+    bool same = true;
+    for (std::size_t i = 0; same && i < n; ++i)
+        same = out_a[i] == out_b[i];
+    CHECK(same);
+}
+
+TEST_CASE("aica thread: the SH-4's register accesses while the thread runs are safe") {
+    // SA-nx: register reads and writes from the SH-4's side while the thread is mid-batch take the
+    // same lock (run under ThreadSanitizer to check). Keying a channel off and on again from the
+    // SH-4 side must still reach the mixer.
+    Rig r;
+    r.square_wave(0x1000, 64, 8000);
+    r.program_channel(0x1000, 64);
+    r.aica.start_thread();
+    std::uint32_t seen = 0;
+    for (int i = 0; i < 50; ++i) {
+        r.key_on();
+        r.sys.sched.advance(A::kSh4CyclesPerSample * A::kThreadBatch);
+        seen |= r.aica.read(A::kRegBase + 0x2810, 2);  // a monitor register the mixer updates
+        r.key_off();
+        r.sys.sched.advance(A::kSh4CyclesPerSample * A::kThreadBatch);
+    }
+    r.aica.stop_thread();
+    CHECK(r.aica.mixer.key_ons >= 50);
+    (void)seen;
+}
