diff --git a/render/include/dream/render/port_menu.h b/render/include/dream/render/port_menu.h
new file mode 100644
index 0000000..33bfd57
--- /dev/null
+++ b/render/include/dream/render/port_menu.h
@@ -0,0 +1,71 @@
+// The port menu (SA-nx): the launcher's own settings, over a paused game. Device-independent like
+// the binding screen (input_menu.h): it draws into the RGBA frame on its way to the GPU and is
+// driven by four calls, so the same menu works from a keyboard on the PC and from the buttons on
+// the Switch.
+//
+// Options persist as KEY=VALUE lines. Unknown keys and bad values are ignored, never fatal: a
+// damaged file must not be able to stop the game from starting.
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+namespace dream::render {
+
+struct PortOptions {
+    bool show_fps = false;
+    // 0: the picture at its own 4:3, bars at the sides. 1: stretched to fill the screen.
+    int screen = 0;
+    int volume = 100;  // percent, 0 to 100 in steps of 10
+    // CPU clock in MHz the platform should ask for, 0 for the system's own. Only offered where
+    // the platform can set it (the Switch); elsewhere the row is hidden and the value kept.
+    int cpu_mhz = 0;
+
+    std::string to_text() const;
+    static PortOptions from_text(std::string_view text);
+    bool operator==(const PortOptions& o) const noexcept {
+        return show_fps == o.show_fps && screen == o.screen && volume == o.volume &&
+               cpu_mhz == o.cpu_mhz;
+    }
+};
+
+// The clock steps offered, in MHz. 0 is the system's own; the rest are the Switch's own CPU
+// rates (1785 is the overclock profile the other ports default to).
+constexpr int kCpuSteps[] = {0, 1224, 1581, 1785};
+
+class PortMenu {
+public:
+    enum class Action { None, Close, Controls, Quit };
+
+    // `can_set_clock`: whether to show the CPU row.
+    void open(const PortOptions& o, bool can_set_clock);
+    void close() { open_ = false; }
+    bool is_open() const noexcept { return open_; }
+
+    const PortOptions& options() const noexcept { return options_; }
+    bool dirty() const noexcept { return dirty_; }
+    void mark_saved() noexcept { dirty_ = false; }
+
+    void move(int delta);    // up or down
+    void adjust(int delta);  // left or right on the current row
+    Action activate();       // A, or return
+    Action back();           // B, or escape: closes the menu
+
+    void draw(std::uint32_t* rgba, unsigned pitch, unsigned width, unsigned height) const;
+
+    // For the footer: what the buttons are called on this platform.
+    std::string help = "ARROWS MOVE AND CHANGE, RETURN CHOOSES, ESCAPE RESUMES";
+
+private:
+    enum Row : int { kResume = 0, kControls, kFps, kScreen, kVolume, kCpu, kQuit, kRowCount };
+    bool visible(int row) const { return row != kCpu || clock_; }
+
+    PortOptions options_{};
+    bool open_ = false;
+    bool dirty_ = false;
+    bool clock_ = false;
+    int row_ = kResume;
+};
+
+}  // namespace dream::render
