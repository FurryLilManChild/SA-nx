+// name ("a" is the bottom face button, which the Switch calls B), so the same bindings file and
+// the same binding screen work on both, and the Dreamcast's buttons sit where they did on a
+// desktop pad.
+#include <switch.h>
+#define VK_USE_PLATFORM_VI_NN 1
+#include <vulkan/vulkan.h>
+
+#include "dream/render/vk/window.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace dream::render::vk {
+
+namespace {
+constexpr std::uint32_t kFramesInFlight = 2;
+
+// SDL's gamepad button names, positional, to the Switch's buttons. The Switch's B is the bottom
+// button, which SDL calls "a".
+struct ButtonName {
+    const char* name;
+    u64 bit;
+};
+constexpr ButtonName kButtons[] = {
+    {"a", HidNpadButton_B},
+    {"b", HidNpadButton_A},
+    {"x", HidNpadButton_Y},
+    {"y", HidNpadButton_X},
+    {"start", HidNpadButton_Plus},
+    {"back", HidNpadButton_Minus},
+    {"leftshoulder", HidNpadButton_L},
+    {"rightshoulder", HidNpadButton_R},
+    {"leftstick", HidNpadButton_StickL},
+    {"rightstick", HidNpadButton_StickR},
+    {"dpup", HidNpadButton_Up},
+    {"dpdown", HidNpadButton_Down},
+    {"dpleft", HidNpadButton_Left},
+    {"dpright", HidNpadButton_Right},
+};
+
+// Axes. The triggers are buttons on a Switch, so they read 0 or full travel; the sticks are
+// signed, with SDL's convention that down is positive.
+enum Axis : int { kLeftX, kLeftY, kRightX, kRightY, kLeftTrigger, kRightTrigger, kAxisCount };
+constexpr const char* kAxisNames[kAxisCount] = {"leftx",  "lefty",       "rightx",
+                                                 "righty", "lefttrigger", "righttrigger"};
+
+// The launcher's own controls (Control order). Menus follow the console's convention: A
+// confirms, B goes back. Menu is Minus and Plus together, handled in poll().
+const u64 kNav[static_cast<unsigned>(Control::Count)] = {
+    HidNpadButton_AnyUp,    // Up: the d-pad or the left stick, for menus
+    HidNpadButton_AnyDown,  // Down
+    HidNpadButton_AnyLeft,  // Left
+    HidNpadButton_AnyRight, // Right
+    HidNpadButton_A,        // A: confirm
+    HidNpadButton_B,        // B
+    HidNpadButton_Y,        // X
+    HidNpadButton_X,        // Y
+    HidNpadButton_Plus,     // Start
+    HidNpadButton_ZL,       // LeftTrigger
+    HidNpadButton_ZR,       // RightTrigger
+    0,                      // Screenshot: the console's own capture button does this
+    0,                      // Capture
+    0,                      // ToggleFps: in the port menu
+    0,                      // Menu: Minus and Plus together, below
+    HidNpadButton_B,        // Back
+};
+
+PadState g_pad;
+bool g_pad_ready = false;
+HidNpadButton g_last_buttons{};
+
+float axis_value(int axis, u64 buttons) {
+    switch (axis) {
+        case kLeftX:
+        case kLeftY: {
+            const HidAnalogStickState s = padGetStickPos(&g_pad, 0);
+            return axis == kLeftX ? static_cast<float>(s.x) / 32767.0f
+                                  : -static_cast<float>(s.y) / 32767.0f;
+        }
+        case kRightX:
+        case kRightY: {
+            const HidAnalogStickState s = padGetStickPos(&g_pad, 1);
+            return axis == kRightX ? static_cast<float>(s.x) / 32767.0f
+                                   : -static_cast<float>(s.y) / 32767.0f;
+        }
+        case kLeftTrigger:
+            return (buttons & HidNpadButton_ZL) ? 1.0f : 0.0f;
+        case kRightTrigger:
+            return (buttons & HidNpadButton_ZR) ? 1.0f : 0.0f;
+        default:
+            return 0.0f;
+    }
+}
+}  // namespace
+
+Window::~Window() {
+    destroy();
+}
+
+bool Window::create(const char* title, int width, int height, bool want_validation) {
+    (void)title;
+    (void)width;
+    (void)height;
+    if (!g_pad_ready) {
+        padConfigureInput(1, HidNpadStyleSet_NpadStandard);
+        padInitializeDefault(&g_pad);
+        g_pad_ready = true;
+    }
+    const std::vector<const char*> extensions = {VK_KHR_SURFACE_EXTENSION_NAME,
+                                                 VK_NN_VI_SURFACE_EXTENSION_NAME};
+    if (!ctx_.create(extensions, want_validation)) {
+        error_ = ctx_.error();
+        return false;
+    }
+    NWindow* win = nwindowGetDefault();
+    nwindowSetDimensions(win, 1280, 720);
+    VkViSurfaceCreateInfoNN sci{};
+    sci.sType = VK_STRUCTURE_TYPE_VI_SURFACE_CREATE_INFO_NN;
+    sci.window = win;
+    if (vkCreateViSurfaceNN(ctx_.instance(), &sci, nullptr, &surface_) != VK_SUCCESS) {
+        error_ = "vkCreateViSurfaceNN failed";
+        return false;
+    }
+
+    VkCommandPoolCreateInfo pci{};
+    pci.sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO;
+    pci.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+    pci.queueFamilyIndex = ctx_.queue_family();
+    vkCreateCommandPool(ctx_.device(), &pci, nullptr, &pool_);
+    cmds_.resize(kFramesInFlight);
+    VkCommandBufferAllocateInfo cai{};
+    cai.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO;
+    cai.commandPool = pool_;
+    cai.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+    cai.commandBufferCount = kFramesInFlight;
+    vkAllocateCommandBuffers(ctx_.device(), &cai, cmds_.data());
+    fences_.resize(kFramesInFlight);
+    acquired_.resize(kFramesInFlight);
+    rendered_.resize(kFramesInFlight);
+    for (std::uint32_t i = 0; i < kFramesInFlight; ++i) {
+        VkFenceCreateInfo fci{};
+        fci.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
+        fci.flags = VK_FENCE_CREATE_SIGNALED_BIT;
+        vkCreateFence(ctx_.device(), &fci, nullptr, &fences_[i]);
+        VkSemaphoreCreateInfo semi{};
+        semi.sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO;
+        vkCreateSemaphore(ctx_.device(), &semi, nullptr, &acquired_[i]);
+        vkCreateSemaphore(ctx_.device(), &semi, nullptr, &rendered_[i]);
+    }
+    refresh_devices();
+    set_bindings(Bindings::defaults());
+    return create_swapchain();
+}
+
+VkPresentModeKHR Window::choose_present_mode() const {
+    return VK_PRESENT_MODE_FIFO_KHR;  // the console's display is vsync; nothing else to measure
+}
+
+bool Window::create_swapchain() {
+    VkSurfaceCapabilitiesKHR caps{};
+    vkGetPhysicalDeviceSurfaceCapabilitiesKHR(ctx_.physical_device(), surface_, &caps);
+    std::uint32_t format_count = 0;
+    vkGetPhysicalDeviceSurfaceFormatsKHR(ctx_.physical_device(), surface_, &format_count, nullptr);
+    std::vector<VkSurfaceFormatKHR> formats(format_count);
+    vkGetPhysicalDeviceSurfaceFormatsKHR(ctx_.physical_device(), surface_, &format_count,
+                                         formats.data());
+    if (formats.empty()) {
+        error_ = "the surface offers no formats";
+        return false;
+    }
+    VkSurfaceFormatKHR chosen = formats[0];
+    for (const auto& f : formats)
+        if (f.format == VK_FORMAT_B8G8R8A8_UNORM || f.format == VK_FORMAT_R8G8B8A8_UNORM) {
+            chosen = f;
+            break;
+        }
+    format_ = chosen.format;
+    extent_ = caps.currentExtent;
+    if (extent_.width == 0xFFFFFFFFu)
+        extent_ = {1280, 720};
+    std::uint32_t image_count = std::max(caps.minImageCount, 2u);
+    if (caps.maxImageCount != 0)
+        image_count = std::min(image_count, caps.maxImageCount);
+
+    VkSwapchainCreateInfoKHR sci{};
+    sci.sType = VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR;
+    sci.surface = surface_;
+    sci.minImageCount = image_count;
+    sci.imageFormat = format_;
+    sci.imageColorSpace = chosen.colorSpace;
+    sci.imageExtent = extent_;
+    sci.imageArrayLayers = 1;
+    sci.imageUsage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+    sci.imageSharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    sci.preTransform = caps.currentTransform;
+    sci.compositeAlpha = VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
+    sci.presentMode = choose_present_mode();
+    sci.clipped = VK_TRUE;
+    if (vkCreateSwapchainKHR(ctx_.device(), &sci, nullptr, &swapchain_) != VK_SUCCESS) {
+        error_ = "vkCreateSwapchainKHR failed";
+        return false;
+    }
+    std::uint32_t count = 0;
+    vkGetSwapchainImagesKHR(ctx_.device(), swapchain_, &count, nullptr);
+    images_.resize(count);
+    vkGetSwapchainImagesKHR(ctx_.device(), swapchain_, &count, images_.data());
+
+    depth_format_ = pick_depth_format(ctx_.physical_device());
+    if (depth_format_ == VK_FORMAT_UNDEFINED ||
+        !depth_.create(ctx_, depth_format_, extent_, VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT,
+                       VK_IMAGE_ASPECT_DEPTH_BIT)) {
+        error_ = "could not create the depth buffer";
+        return false;
+    }
+
+    VkAttachmentDescription attachments[2]{};
+    attachments[0].format = format_;
+    attachments[0].samples = VK_SAMPLE_COUNT_1_BIT;
+    attachments[0].loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+    attachments[0].storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+    attachments[0].stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+    attachments[0].stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+    attachments[0].initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    attachments[0].finalLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR;
+    attachments[1].format = depth_format_;
+    attachments[1].samples = VK_SAMPLE_COUNT_1_BIT;
+    attachments[1].loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+    attachments[1].storeOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+    attachments[1].stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+    attachments[1].stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+    attachments[1].initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    attachments[1].finalLayout = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
+    VkAttachmentReference colour_ref{0, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL};
+    VkAttachmentReference depth_ref{1, VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL};
+    VkSubpassDescription subpass{};
+    subpass.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+    subpass.colorAttachmentCount = 1;
+    subpass.pColorAttachments = &colour_ref;
+    subpass.pDepthStencilAttachment = &depth_ref;
+    VkSubpassDependency dep{};
+    dep.srcSubpass = VK_SUBPASS_EXTERNAL;
+    dep.srcStageMask =
+        VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT;
+    dep.dstStageMask =
+        VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT;
+    dep.dstAccessMask =
+        VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
+    VkRenderPassCreateInfo rci{};
+    rci.sType = VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO;
+    rci.attachmentCount = 2;
+    rci.pAttachments = attachments;
+    rci.subpassCount = 1;
+    rci.pSubpasses = &subpass;
+    rci.dependencyCount = 1;
+    rci.pDependencies = &dep;
+    vkCreateRenderPass(ctx_.device(), &rci, nullptr, &render_pass_);
+
+    views_.resize(count);
+    framebuffers_.resize(count);
+    for (std::uint32_t i = 0; i < count; ++i) {
+        VkImageViewCreateInfo vci{};
+        vci.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+        vci.image = images_[i];
+        vci.viewType = VK_IMAGE_VIEW_TYPE_2D;
+        vci.format = format_;
+        vci.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+        vkCreateImageView(ctx_.device(), &vci, nullptr, &views_[i]);
+        const VkImageView fb_attachments[2] = {views_[i], depth_.view()};
+        VkFramebufferCreateInfo fci{};
+        fci.sType = VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO;
+        fci.renderPass = render_pass_;
+        fci.attachmentCount = 2;
+        fci.pAttachments = fb_attachments;
+        fci.width = extent_.width;
+        fci.height = extent_.height;
+        fci.layers = 1;
+        vkCreateFramebuffer(ctx_.device(), &fci, nullptr, &framebuffers_[i]);
+    }
+    return true;
+}
+
+void Window::destroy_swapchain() {
+    if (!ctx_.device())
+        return;
+    vkDeviceWaitIdle(ctx_.device());
+    for (VkFramebuffer f : framebuffers_) vkDestroyFramebuffer(ctx_.device(), f, nullptr);
+    for (VkImageView v : views_) vkDestroyImageView(ctx_.device(), v, nullptr);
+    framebuffers_.clear();
+    views_.clear();
+    images_.clear();
+    depth_.destroy();
+    if (render_pass_) {
+        vkDestroyRenderPass(ctx_.device(), render_pass_, nullptr);
+        render_pass_ = VK_NULL_HANDLE;
+    }
+    if (swapchain_) {
+        vkDestroySwapchainKHR(ctx_.device(), swapchain_, nullptr);
+        swapchain_ = VK_NULL_HANDLE;
+    }
+}
+
+bool Window::recreate_swapchain() {
+    destroy_swapchain();
+    return create_swapchain();
+}
+
+void Window::refresh_devices() {
+    // One controller: the console's own (handheld or player 1). pads_ holds a placeholder so that
+    // gamepad_connected() is true; nothing here dereferences it.
+    pads_.assign(1, nullptr);
+    devices_.assign({"KEYBOARD", "SWITCH CONTROLLER"});
+}
+
+void Window::set_bindings(const Bindings& b) {
+    bindings_ = b;
+    for (unsigned i = 0; i < kPadControlCount; ++i) {
+        const Binding& bind = bindings_.gamepad.b[i];
+        gpad_[i] = Resolved{};
+        key_[i] = Resolved{};
+        if (bind.source == BindSource::Button) {
+            for (const ButtonName& n : kButtons)
+                if (bind.code == n.name)
+                    gpad_[i] = Resolved{BindSource::Button, static_cast<int>(&n - kButtons), 1};
+        } else if (bind.source == BindSource::Axis) {
+            for (int a = 0; a < kAxisCount; ++a)
+                if (bind.code == kAxisNames[a])
+                    gpad_[i] = Resolved{BindSource::Axis, a, bind.sign};
+        }
+    }
+}
+
+void Window::begin_capture() noexcept {
+    capturing_ = true;
+    captured_ = false;
+    capture_cancelled_ = false;
+    capture_ = Binding{};
+}
+
+void Window::cancel_capture() noexcept {
+    capturing_ = false;
+    captured_ = false;
+}
+
+bool Window::take_capture(Binding& out, bool& cancelled) noexcept {
+    if (!captured_)
+        return false;
+    captured_ = false;
+    out = capture_;
+    cancelled = capture_cancelled_;
+    return true;
+}
+
+bool Window::poll() {
+    // HOME then Close, or the system asking the app to exit.
+    if (!appletMainLoop())
+        running_ = false;
+    padUpdate(&g_pad);
+    const u64 buttons = padGetButtons(&g_pad);
+    const u64 down = padGetButtonsDown(&g_pad);
+
+    // Rebinding: the next button or stick push becomes the binding. Minus cancels (the console
+    // has no escape key, and Minus is not a Dreamcast button).
+    if (capturing_ && down) {
+        captured_ = true;
+        capturing_ = false;
+        if (down & HidNpadButton_Minus) {
+            capture_cancelled_ = true;
+        } else if (down & HidNpadButton_ZL) {
+            capture_ = Binding{BindSource::Axis, "lefttrigger", 1};
+        } else if (down & HidNpadButton_ZR) {
+            capture_ = Binding{BindSource::Axis, "righttrigger", 1};
+        } else {
+            capture_cancelled_ = true;
+            for (const ButtonName& n : kButtons)
+                if (down & n.bit) {
+                    capture_ = Binding{BindSource::Button, n.name, 1};
+                    capture_cancelled_ = false;
+                    break;
+                }
+        }
+    }
+
+    // The launcher's controls. Menu is Minus and Plus held together; on that frame Start is not
+    // also reported, so opening the menu does not also pause the game underneath it.
+    const bool combo = (buttons & HidNpadButton_Minus) && (buttons & HidNpadButton_Plus);
+    for (unsigned i = 0; i < static_cast<unsigned>(Control::Count); ++i) {
+        const bool was = held_[i];
+        bool now = kNav[i] != 0 && (buttons & kNav[i]) != 0;
+        if (static_cast<Control>(i) == Control::Menu)
+            now = combo;
+        if (static_cast<Control>(i) == Control::Start && (buttons & HidNpadButton_Minus))
+            now = false;
+        held_[i] = now;
+        pressed_[i] = now && !was;
+    }
+
+    const std::uint64_t now_ns = armTicksToNs(armGetSystemTick());
+    float dt = last_poll_ns_ ? static_cast<float>(now_ns - last_poll_ns_) * 1e-9f : 0.0f;
+    last_poll_ns_ = now_ns;
+    dt = std::clamp(dt, 0.0f, 0.25f);
+
+    const float dead = static_cast<float>(bindings_.deadzone_percent) / 100.0f;
+    for (unsigned i = 0; i < kPadControlCount; ++i) {
+        bool digital_on = false;
+        float analogue = 0.0f;
+        if (!capturing_) {
+            if (gpad_[i].source == BindSource::Button) {
+                const u64 bit = kButtons[gpad_[i].code].bit;
+                // Plus is Start, except while Minus is down (the menu combination).
+                if ((buttons & bit) && !(bit == HidNpadButton_Plus && (buttons & HidNpadButton_Minus)))
+                    digital_on = true;
+            } else if (gpad_[i].source == BindSource::Axis) {
+                const float raw = axis_value(gpad_[i].code, buttons);
+                const float half = gpad_[i].sign < 0 ? -raw : raw;
+                if (gpad_[i].code == kLeftTrigger || gpad_[i].code == kRightTrigger) {
+                    if (half > 0.5f)
+                        digital_on = true;  // a button on this console: ramps like a key
+                } else if (half > dead) {
+                    analogue = std::max(analogue, std::min(1.0f, (half - dead) / (1.0f - dead)));
+                }
+            }
+        }
+        const bool is_trigger = i == static_cast<unsigned>(PadControl::LeftTrigger) ||
+                                i == static_cast<unsigned>(PadControl::RightTrigger);
+        float value = analogue;
+        if (is_trigger && bindings_.trigger_ramp) {
+            constexpr float kRampSeconds = 0.15f;
+            ramp_[i] = digital_on ? std::min(1.0f, ramp_[i] + dt / kRampSeconds) : 0.0f;
+            value = std::max(value, ramp_[i]);
+        } else {
+            ramp_[i] = 0.0f;
+            if (digital_on)
+                value = 1.0f;
+        }
+        const bool was = pad_held_[i];
+        pad_held_[i] = value > 0.0f;
+        pad_pressed_[i] = pad_held_[i] && !was;
+        pad_value_[i] = value;
+    }
+    g_last_buttons = static_cast<HidNpadButton>(buttons);
+    return running_;
+}
