+void Window::refresh_devices() {
+    // One controller: the console's own (handheld or player 1). pads_ holds a placeholder so that
+    // gamepad_connected() is true; nothing here dereferences it.
+    pads_.assign(1, nullptr);
+    devices_.assign({"KEYBOARD", "SWITCH CONTROLLER"});
+}
+
+void Window::set_bindings(const Bindings& b) {
+    bindings_ = b;
+    for (unsigned i = 0; i < kPadControlCount; ++i) {
+        const Binding& bind = bindings_.gamepad.b[i];
+        gpad_[i] = Resolved{};
+        key_[i] = Resolved{};
+        if (bind.source == BindSource::Button) {
+            for (const ButtonName& n : kButtons)
+                if (bind.code == n.name)
+                    gpad_[i] = Resolved{BindSource::Button, static_cast<int>(&n - kButtons), 1};
+        } else if (bind.source == BindSource::Axis) {
+            for (int a = 0; a < kAxisCount; ++a)
+                if (bind.code == kAxisNames[a])
+                    gpad_[i] = Resolved{BindSource::Axis, a, bind.sign};
+        }
+    }
+}
+
+void Window::begin_capture() noexcept {
+    capturing_ = true;
+    captured_ = false;
+    capture_cancelled_ = false;
+    capture_ = Binding{};
+}
+
+void Window::cancel_capture() noexcept {
+    capturing_ = false;
+    captured_ = false;
+}
+
+bool Window::take_capture(Binding& out, bool& cancelled) noexcept {
+    if (!captured_)
+        return false;
+    captured_ = false;
+    out = capture_;
+    cancelled = capture_cancelled_;
+    return true;
+}
+
+bool Window::poll() {
+    // HOME then Close, or the system asking the app to exit.
+    if (!appletMainLoop())
+        running_ = false;
+    padUpdate(&g_pad);
+    const u64 buttons = padGetButtons(&g_pad);
+    const u64 down = padGetButtonsDown(&g_pad);
+
+    // Rebinding: the next button or stick push becomes the binding. Minus cancels (the console
+    // has no escape key, and Minus is not a Dreamcast button).
+    if (capturing_ && down) {
+        captured_ = true;
+        capturing_ = false;
+        if (down & HidNpadButton_Minus) {
+            capture_cancelled_ = true;
+        } else if (down & HidNpadButton_ZL) {
+            capture_ = Binding{BindSource::Axis, "lefttrigger", 1};
+        } else if (down & HidNpadButton_ZR) {
+            capture_ = Binding{BindSource::Axis, "righttrigger", 1};
+        } else {
+            capture_cancelled_ = true;
+            for (const ButtonName& n : kButtons)
+                if (down & n.bit) {
+                    capture_ = Binding{BindSource::Button, n.name, 1};
+                    capture_cancelled_ = false;
+                    break;
+                }
+        }
+    }
+
+    // The launcher's controls. SA-nx: the menu is Minus on its own. Minus is not a Dreamcast
+    // button, so nothing the game reads is lost; Minus and Plus together used to open it, but Plus
+    // is Start, and pressing it first started things in the game (Mark, test9: it picked a
+    // character on the select screen).
+    const bool menu_button = (buttons & HidNpadButton_Minus) != 0;
+    for (unsigned i = 0; i < static_cast<unsigned>(Control::Count); ++i) {
+        const bool was = held_[i];
+        bool now = kNav[i] != 0 && (buttons & kNav[i]) != 0;
+        if (static_cast<Control>(i) == Control::Menu)
+            now = menu_button;
+        held_[i] = now;
+        pressed_[i] = now && !was;
+    }
+
+    const std::uint64_t now_ns = armTicksToNs(armGetSystemTick());
+    float dt = last_poll_ns_ ? static_cast<float>(now_ns - last_poll_ns_) * 1e-9f : 0.0f;
+    last_poll_ns_ = now_ns;
+    dt = std::clamp(dt, 0.0f, 0.25f);
+
+    const float dead = static_cast<float>(bindings_.deadzone_percent) / 100.0f;
+    for (unsigned i = 0; i < kPadControlCount; ++i) {
+        bool digital_on = false;
+        float analogue = 0.0f;
+        if (!capturing_) {
+            if (gpad_[i].source == BindSource::Button) {
+                const u64 bit = kButtons[gpad_[i].code].bit;
+                if (buttons & bit)
+                    digital_on = true;
+            } else if (gpad_[i].source == BindSource::Axis) {
+                const float raw = axis_value(gpad_[i].code, buttons);
+                const float half = gpad_[i].sign < 0 ? -raw : raw;
+                if (gpad_[i].code == kLeftTrigger || gpad_[i].code == kRightTrigger) {
+                    if (half > 0.5f)
+                        digital_on = true;  // a button on this console: ramps like a key
+                } else if (half > dead) {
+                    analogue = std::max(analogue, std::min(1.0f, (half - dead) / (1.0f - dead)));
+                }
+            }
+        }
+        const bool is_trigger = i == static_cast<unsigned>(PadControl::LeftTrigger) ||
+                                i == static_cast<unsigned>(PadControl::RightTrigger);
+        float value = analogue;
+        if (is_trigger && bindings_.trigger_ramp) {
+            constexpr float kRampSeconds = 0.15f;
+            ramp_[i] = digital_on ? std::min(1.0f, ramp_[i] + dt / kRampSeconds) : 0.0f;
+            value = std::max(value, ramp_[i]);
+        } else {
+            ramp_[i] = 0.0f;
+            if (digital_on)
+                value = 1.0f;
+        }
+        const bool was = pad_held_[i];
+        pad_held_[i] = value > 0.0f;
+        pad_pressed_[i] = pad_held_[i] && !was;
+        pad_value_[i] = value;
+    }
+    g_last_buttons = static_cast<HidNpadButton>(buttons);
+    return running_;
+}
