diff --git a/render/tests/test_port_menu.cpp b/render/tests/test_port_menu.cpp
new file mode 100644
index 0000000..360fdc7
--- /dev/null
+++ b/render/tests/test_port_menu.cpp
@@ -0,0 +1,89 @@
+// The port menu (SA-nx): options round-trip through their file, a damaged file falls back to
+// defaults, and the menu moves, changes and closes as the footer says.
+#include <cstdint>
+#include <vector>
+
+#include "dream/render/port_menu.h"
+
+#include "doctest.h"
+
+using namespace dream::render;
+
+TEST_CASE("port menu: options round-trip through their text") {
+    PortOptions o;
+    o.show_fps = true;
+    o.screen = 1;
+    o.volume = 70;
+    o.cpu_mhz = 1785;
+    o.gpu_mhz = 768;
+    o.mem_mhz = 1600;
+    o.translucency = 1;
+    const PortOptions back = PortOptions::from_text(o.to_text());
+    CHECK(back == o);
+}
+
+TEST_CASE("port menu: a damaged options file keeps the defaults for what it cannot read") {
+    const PortOptions o =
+        PortOptions::from_text("# comment\nVOLUME=lots\nSCREEN=stretch\r\nCPU_MHZ=9999\ngarbage\n"
+                               "GPU_MHZ=1\n");
+    CHECK(o.volume == 100);   // unreadable: default
+    CHECK(o.screen == 1);     // read, and the Windows line ending did not matter
+    CHECK(o.cpu_mhz == 0);    // not an offered rate: stock
+    CHECK_FALSE(o.show_fps);  // absent: default
+    CHECK(o.gpu_mhz == 0);    // not an offered rate: stock
+    CHECK(o.translucency == 0);
+}
+
+TEST_CASE("port menu: moving, changing and closing") {
+    PortMenu m;
+    PortOptions o;
+    m.open(o, /*can_set_clock=*/false);
+    CHECK(m.is_open());
+    // Resume, Controls, FPS, Screen, Volume, Translucency, (CPU and GPU hidden), Quit.
+    m.move(1);
+    m.move(1);  // SHOW FPS
+    CHECK(m.activate() == PortMenu::Action::None);
+    CHECK(m.options().show_fps);
+    CHECK(m.dirty());
+    m.move(1);
+    m.move(1);  // VOLUME
+    m.adjust(-1);
+    CHECK(m.options().volume == 90);
+    m.move(1);  // TRANSLUCENCY: accurate, then lean, then fast, then round again
+    CHECK(m.activate() == PortMenu::Action::None);
+    CHECK(m.options().translucency == 2);
+    m.adjust(1);
+    CHECK(m.options().translucency == 1);
+    m.adjust(1);
+    CHECK(m.options().translucency == 0);
+    m.adjust(-1);
+    CHECK(m.options().translucency == 1);
+    CHECK(PortOptions::from_text("TRANSLUCENCY=lean\n").translucency == 2);
+    m.move(1);  // the clock rows are hidden, so this is QUIT
+    CHECK(m.activate() == PortMenu::Action::Quit);
+    CHECK_FALSE(m.is_open());
+
+    m.open(o, /*can_set_clock=*/true);
+    m.move(-1);  // wraps to QUIT
+    m.move(-1);  // MEMORY CLOCK, offered this time
+    m.adjust(1);
+    CHECK(m.options().mem_mhz == kMemSteps[1]);
+    m.move(-1);  // GPU CLOCK
+    m.adjust(1);
+    CHECK(m.options().gpu_mhz == kGpuSteps[1]);
+    m.move(-1);  // CPU CLOCK
+    m.adjust(1);
+    CHECK(m.options().cpu_mhz == kCpuSteps[1]);
+    CHECK(m.back() == PortMenu::Action::Close);
+    CHECK_FALSE(m.is_open());
+}
+
+TEST_CASE("port menu: draws inside the frame") {
+    PortMenu m;
+    m.open(PortOptions{}, true);
+    std::vector<std::uint32_t> px(640 * 480, 0x12345678u);
+    m.draw(px.data(), 640, 640, 480);
+    // The shade covers everything and the card is white somewhere in the middle.
+    CHECK(px[0] != 0x12345678u);
+    CHECK(px[240 * 640 + 320] != 0x12345678u);
+}
