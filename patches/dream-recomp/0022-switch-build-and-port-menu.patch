+float Offscreen::translucent_depth(const Frame& frame, const FrameGeometry& geometry,
+                                   const VkRect2D& box) const {
+    const float sx = static_cast<float>(extent_.width) / geometry.width;
+    const float sy = static_cast<float>(extent_.height) / geometry.height;
+    const float w = static_cast<float>(extent_.width), h = static_cast<float>(extent_.height);
+    double area = 0.0;
+    for (const Polygon& p : frame.lists[static_cast<unsigned>(ListType::Translucent)]) {
+        for (std::uint32_t i = 0; i + 2 < p.count; ++i) {
+            float x[3], y[3];
+            for (int k = 0; k < 3; ++k) {
+                const Vertex& v = frame.vertices[p.first + i + static_cast<std::uint32_t>(k)];
