+bool Offscreen::translucent_bounds(const Frame& frame, const FrameGeometry& geometry,
+                                   VkRect2D& out) const {
+    const auto& list = frame.lists[static_cast<unsigned>(ListType::Translucent)];
+    if (list.empty())
         return false;
+    float x0 = 1e30f, y0 = 1e30f, x1 = -1e30f, y1 = -1e30f;
+    for (const Polygon& p : list)
+        for (std::uint32_t i = 0; i < p.count; ++i) {
+            const Vertex& v = frame.vertices[p.first + i];
+            x0 = std::min(x0, v.x);
+            x1 = std::max(x1, v.x);
+            y0 = std::min(y0, v.y);
+            y1 = std::max(y1, v.y);
+        }
+    // Guest screen coordinates to target pixels, rounded outwards with a pixel to spare for
+    // rasterisation at the edges.
+    const float sx = static_cast<float>(extent_.width) / geometry.width;
+    const float sy = static_cast<float>(extent_.height) / geometry.height;
+    const auto clampi = [](float v, float hi) {
+        return static_cast<std::int32_t>(std::max(0.0f, std::min(v, hi)));
+    };
+    const std::int32_t l = clampi(std::floor((x0 - geometry.left) * sx) - 2.0f,
+                                  static_cast<float>(extent_.width));
+    const std::int32_t t = clampi(std::floor((y0 - geometry.top) * sy) - 2.0f,
+                                  static_cast<float>(extent_.height));
+    const std::int32_t r = clampi(std::ceil((x1 - geometry.left) * sx) + 2.0f,
+                                  static_cast<float>(extent_.width));
+    const std::int32_t b = clampi(std::ceil((y1 - geometry.top) * sy) + 2.0f,
+                                  static_cast<float>(extent_.height));
+    if (r <= l || b <= t)
+        return false;  // entirely off screen
+    if (full_oit_) {  // DREAM_OIT_FULL: the whole target, to compare against
+        out.offset = {0, 0};
+        out.extent = extent_;
+        return true;
+    }
+    out.offset = {l, t};
+    out.extent = {static_cast<std::uint32_t>(r - l), static_cast<std::uint32_t>(b - t)};
+    return true;
+}
