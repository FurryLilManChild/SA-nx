+
+bool Window::begin_frame(std::uint32_t& image_index, VkCommandBuffer& cmd) {
+    if (!swapchain_)
+        return false;
+    vkWaitForFences(ctx_.device(), 1, &fences_[frame_], VK_TRUE, UINT64_MAX);
+    const VkResult r = vkAcquireNextImageKHR(ctx_.device(), swapchain_, UINT64_MAX,
+                                             acquired_[frame_], VK_NULL_HANDLE, &image_index);
+    if (r == VK_ERROR_OUT_OF_DATE_KHR)
+        return false;
+    if (r != VK_SUCCESS && r != VK_SUBOPTIMAL_KHR) {
+        error_ = "vkAcquireNextImageKHR failed";
+        return false;
+    }
+    vkResetFences(ctx_.device(), 1, &fences_[frame_]);
+    cmd = cmds_[frame_];
+    vkResetCommandBuffer(cmd, 0);
+    VkCommandBufferBeginInfo bi{};
+    bi.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
+    bi.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    vkBeginCommandBuffer(cmd, &bi);
+    return true;
+}
+
+bool Window::end_frame(std::uint32_t image_index) {
+    VkCommandBuffer cmd = cmds_[frame_];
+    vkEndCommandBuffer(cmd);
+    const VkPipelineStageFlags wait_stage = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
+    VkSubmitInfo si{};
+    si.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
+    si.waitSemaphoreCount = 1;
+    si.pWaitSemaphores = &acquired_[frame_];
+    si.pWaitDstStageMask = &wait_stage;
+    si.commandBufferCount = 1;
+    si.pCommandBuffers = &cmd;
+    si.signalSemaphoreCount = 1;
+    si.pSignalSemaphores = &rendered_[frame_];
+    vkQueueSubmit(ctx_.queue(), 1, &si, fences_[frame_]);
+    VkPresentInfoKHR pi{};
+    pi.sType = VK_STRUCTURE_TYPE_PRESENT_INFO_KHR;
+    pi.waitSemaphoreCount = 1;
+    pi.pWaitSemaphores = &rendered_[frame_];
+    pi.swapchainCount = 1;
+    pi.pSwapchains = &swapchain_;
+    pi.pImageIndices = &image_index;
+    const VkResult r = vkQueuePresentKHR(ctx_.queue(), &pi);
+    last_presented_ = image_index;
+    frame_ = (frame_ + 1) % kFramesInFlight;
+    return r == VK_SUCCESS || r == VK_SUBOPTIMAL_KHR;
+}
+
+bool Window::read_pixels(std::vector<std::uint8_t>& out, std::uint32_t& width,
+                         std::uint32_t& height) {
+    (void)out;
+    (void)width;
+    (void)height;
+    return false;  // the console's capture button takes screenshots
+}
+
+void Window::destroy() {
+    if (ctx_.device()) {
+        vkDeviceWaitIdle(ctx_.device());
+        destroy_swapchain();
+        for (VkFence f : fences_) vkDestroyFence(ctx_.device(), f, nullptr);
+        for (VkSemaphore s : acquired_) vkDestroySemaphore(ctx_.device(), s, nullptr);
+        for (VkSemaphore s : rendered_) vkDestroySemaphore(ctx_.device(), s, nullptr);
+        fences_.clear();
+        acquired_.clear();
+        rendered_.clear();
+        if (pool_) {
+            vkDestroyCommandPool(ctx_.device(), pool_, nullptr);
+            pool_ = VK_NULL_HANDLE;
+        }
+    }
+    if (surface_ && ctx_.instance()) {
+        vkDestroySurfaceKHR(ctx_.instance(), surface_, nullptr);
+        surface_ = VK_NULL_HANDLE;
+    }
+    ctx_.destroy();
+    pads_.clear();
+    devices_.clear();
+}
+
+// Beside the game, so the bindings travel with the app folder on the SD card.
+std::string default_bindings_path() {
+    return "sdmc:/switch/sonicadv/bindings.txt";
+}
+
+}  // namespace dream::render::vk
diff --git a/render/tests/test_port_menu.cpp b/render/tests/test_port_menu.cpp
new file mode 100644
index 0000000..270f30a
--- /dev/null
+++ b/render/tests/test_port_menu.cpp
@@ -0,0 +1,115 @@
+// The port menu (SA-nx): options round-trip through their file, a damaged file falls back to
+// defaults, and the menu moves, changes and closes as the footer says.
+#include <cstdint>
+#include <vector>
+
+#include "dream/render/port_menu.h"
+
+#include "doctest.h"
+
+using namespace dream::render;
+
+TEST_CASE("port menu: options round-trip through their text") {
+    PortOptions o;
+    o.show_fps = true;
+    o.screen = 1;
+    o.volume = 70;
+    o.cpu_mhz = 1785;
+    o.gpu_mhz = 768;
+    o.mem_mhz = 1600;
+    o.translucency = 1;
+    const PortOptions back = PortOptions::from_text(o.to_text());
+    CHECK(back == o);
+}
+
+TEST_CASE("port menu: a damaged options file keeps the defaults for what it cannot read") {
+    const PortOptions o =
+        PortOptions::from_text("# comment\nVOLUME=lots\nSCREEN=stretch\r\nCPU_MHZ=9999\ngarbage\n"
+                               "GPU_MHZ=1\n");
+    CHECK(o.volume == 100);   // unreadable: default
+    CHECK(o.screen == 1);     // read, and the Windows line ending did not matter
+    CHECK(o.cpu_mhz == 0);    // not an offered rate: stock
+    CHECK_FALSE(o.show_fps);  // absent: default
+    CHECK(o.gpu_mhz == 0);    // not an offered rate: stock
+    CHECK(o.translucency == 0);
+}
+
+TEST_CASE("port menu: moving, changing and closing") {
+    PortMenu m;
+    PortOptions o;
+    m.open(o, /*can_set_clock=*/false);
+    CHECK(m.is_open());
+    // Resume, Controls, FPS, Screen, Volume, Translucency, (CPU and GPU hidden), Quit.
+    m.move(1);
+    m.move(1);  // SHOW FPS
+    CHECK(m.activate() == PortMenu::Action::None);
+    CHECK(m.options().show_fps);
+    CHECK(m.dirty());
+    m.move(1);
+    m.move(1);  // VOLUME
+    m.adjust(-1);
+    CHECK(m.options().volume == 90);
+    m.move(1);  // TRANSLUCENCY: accurate, lean, triangle, strip, then round again
+    CHECK(m.activate() == PortMenu::Action::None);
+    CHECK(m.options().translucency == 2);
+    m.adjust(1);
+    CHECK(m.options().translucency == 3);
+    m.adjust(1);
+    CHECK(m.options().translucency == 1);
+    m.adjust(1);
+    CHECK(m.options().translucency == 0);
+    m.adjust(-1);
+    CHECK(m.options().translucency == 1);
+    CHECK(PortOptions::from_text("TRANSLUCENCY=lean\n").translucency == 2);
+    CHECK(PortOptions::from_text("TRANSLUCENCY=triangle\n").translucency == 3);
+    CHECK(PortOptions::from_text(o.to_text()).translucency == o.translucency);
+    m.move(1);  // RESOLUTION IN GAME: 1x, 1.5x, 2x, then round again
+    CHECK(m.options().scale == 100);
+    CHECK(m.activate() == PortMenu::Action::None);  // A steps it, as on the other value rows
+    CHECK(m.options().scale == 150);
+    m.adjust(1);
+    CHECK(m.options().scale == 200);
+    m.adjust(1);
+    CHECK(m.options().scale == 100);
+    m.adjust(-1);
+    CHECK(m.options().scale == 200);
+    CHECK(PortOptions::from_text("SCALE=1.5\n").scale == 150);
+    CHECK(PortOptions::from_text("SCALE=3\n").scale == 200);  // test15's 3x
+    CHECK(PortOptions::from_text("SCALE=junk\n").scale == 100);
+    CHECK(PortOptions::from_text(m.options().to_text()).scale == 200);
+    m.move(1);  // FRAME PACING: smooth, low latency
+    CHECK(m.options().pacing == 0);
+    CHECK(m.activate() == PortMenu::Action::None);
+    CHECK(m.options().pacing == 1);
+    CHECK(PortOptions::from_text(m.options().to_text()).pacing == 1);
+    m.adjust(1);
+    CHECK(m.options().pacing == 0);
+    CHECK(PortOptions::from_text("PACING=junk\n").pacing == 0);
+    m.move(1);  // the clock rows are hidden, so this is QUIT
+    CHECK(m.activate() == PortMenu::Action::Quit);
+    CHECK_FALSE(m.is_open());
+
+    m.open(o, /*can_set_clock=*/true);
+    m.move(-1);  // wraps to QUIT
+    m.move(-1);  // MEMORY CLOCK, offered this time
+    m.adjust(1);
+    CHECK(m.options().mem_mhz == kMemSteps[1]);
+    m.move(-1);  // GPU CLOCK
+    m.adjust(1);
+    CHECK(m.options().gpu_mhz == kGpuSteps[1]);
+    m.move(-1);  // CPU CLOCK
+    m.adjust(1);
+    CHECK(m.options().cpu_mhz == kCpuSteps[1]);
+    CHECK(m.back() == PortMenu::Action::Close);
+    CHECK_FALSE(m.is_open());
+}
+
+TEST_CASE("port menu: draws inside the frame") {
+    PortMenu m;
+    m.open(PortOptions{}, true);
+    std::vector<std::uint32_t> px(640 * 480, 0x12345678u);
+    m.draw(px.data(), 640, 640, 480);
+    // The shade covers everything and the card is white somewhere in the middle.
+    CHECK(px[0] != 0x12345678u);
+    CHECK(px[240 * 640 + 320] != 0x12345678u);
+}
