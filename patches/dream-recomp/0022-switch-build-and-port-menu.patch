+}
+template <typename T>
+[[gnu::noinline]] T gld_slow(::dream::Memory& m, std::uint32_t a) {
+    if constexpr (sizeof(T) == 1)
+        return m.read8(a);
+    else if constexpr (sizeof(T) == 2)
+        return m.read16(a);
+    else if constexpr (sizeof(T) == 4)
+        return m.read32(a);
+    else
+        return m.read64(a);
+}
+template <typename T>
+[[gnu::noinline]] void gst_slow(::dream::Memory& m, std::uint32_t a, T v) {
+    if constexpr (sizeof(T) == 1)
+        m.write8(a, v);
+    else if constexpr (sizeof(T) == 2)
+        m.write16(a, v);
+    else if constexpr (sizeof(T) == 4)
+        m.write32(a, v);
+    else
+        m.write64(a, v);
