diff --git a/render/tests/test_texture.cpp b/render/tests/test_texture.cpp
index 928bd75..46fd684 100644
--- a/render/tests/test_texture.cpp
+++ b/render/tests/test_texture.cpp
@@ -321,3 +321,41 @@ TEST_CASE("texture: a VQ mip chain keeps its one-byte offset") {
     REQUIRE(pixels.size() == 256);
     for (u32 p : pixels) CHECK(p == 0xFF0000FFu);
 }
+
+TEST_CASE("texture: a stride texture's rows are TEXT_CONTROL texels apart") {
+    // SA-nx: a 320-pixel-wide movie frame in a 512x256 YUV422 stride texture. The image stays
+    // 512 wide (that is what u is scaled by); only the step from row to row is the stride.
+    auto v = vram(1024 * 1024);
+    TextureInfo info;
+    const u32 tcw = make_tcw(0, 3, /*twiddled=*/false) | (1u << 25);  // YUV422, stride select
+    REQUIRE(describe_texture(tcw, make_tsp(6, 5), 320, info));
+    CHECK(info.width == 512);
+    CHECK(info.height == 256);
+    CHECK(info.pitch == 320);
+    CHECK_FALSE(info.twiddled);
+    // Row y, texel pair p: luma 2y+p bright in rows, so each row has its own value.
+    for (u32 y = 0; y < 4; ++y)
+        for (u32 x = 0; x < 320; x += 2) {
+            const std::size_t at = (static_cast<std::size_t>(y) * 320 + x) * 2;
+            const std::uint8_t luma = static_cast<std::uint8_t>(40 + 50 * y);
+            v[at] = 128;       // u
+            v[at + 1] = luma;  // y0
+            v[at + 2] = 128;   // v
+            v[at + 3] = luma;  // y1
+        }
+    std::vector<u32> pixels;
+    std::uint32_t palette[1024] = {};
+    REQUIRE(decode_texture(info, v.data(), v.size(), palette, pixels));
+    REQUIRE(pixels.size() == 512u * 256u);
+    // Grey, brightening row by row; read at the 512-wide pitch it would smear rows together.
+    for (u32 y = 0; y < 4; ++y) {
+        const u32 first = pixels[y * 512 + 0], last = pixels[y * 512 + 318];
+        CHECK(first == last);
+        if (y > 0)
+            CHECK((first & 0xFFu) > (pixels[(y - 1) * 512] & 0xFFu));
+    }
+    // Without a stride width the pitch falls back to the texture's own width.
+    REQUIRE(describe_texture(tcw, make_tsp(6, 5), 0, info));
+    CHECK(info.pitch == 512);
+}
+
