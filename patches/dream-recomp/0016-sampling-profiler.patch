+// SA-nx: a sampling profiler for the launcher (--profile FILE). Windows only; elsewhere start()
+// says so and returns false. The implementation lives in profiler.cpp so that <windows.h> stays out
+// of boot_main.cpp.
+#pragma once
+
+#include <memory>
+#include <string>
+
+namespace sanx {
+
+class ProfilerImpl;
+
+class Profiler {
+public:
+    Profiler();
+    ~Profiler();
+    // Starts sampling the calling thread.
+    bool start();
+    // Stops sampling and writes the report to `path`. Does nothing if start() failed.
+    void finish(const std::string& path);
+
+private:
+    std::unique_ptr<ProfilerImpl> impl_;
+};
+
+}  // namespace sanx
