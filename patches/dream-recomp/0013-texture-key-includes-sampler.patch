diff --git a/render/tests/test_tsp.cpp b/render/tests/test_tsp.cpp
index 7b38372..eb7e840 100644
--- a/render/tests/test_tsp.cpp
+++ b/render/tests/test_tsp.cpp
@@ -80,3 +80,22 @@ TEST_CASE("tsp: the sampler key covers filtering, clamping and mirroring and not
     for (unsigned bit : {13u, 14u, 15u, 16u, 17u, 18u}) CHECK(tsp_sampler_key(1u << bit) != 0);
     for (unsigned bit : {0u, 6u, 12u, 19u, 20u, 26u, 31u}) CHECK(tsp_sampler_key(1u << bit) == 0);
 }
+
+TEST_CASE("tsp: polygons that share a texture but sample it differently get different keys") {
+    // Captured from Sonic Adventure's Emerald Coast: one rock texture drawn with V clamped, with U
+    // and V clamped, and with neither, in the same frame.
+    const std::uint32_t tcw = 0x88061640u;
+    const std::uint64_t clamp_v = texture_sampling_key(tcw, 0x2008a4edu);
+    const std::uint64_t clamp_uv = texture_sampling_key(tcw, 0x2009a4edu);
+    const std::uint64_t wrap = texture_sampling_key(tcw, 0x200824edu);
+    CHECK(clamp_v != clamp_uv);
+    CHECK(clamp_v != wrap);
+    CHECK(clamp_uv != wrap);
+    // Fields that change neither the image nor the sampler (shading, blending) share one key.
+    CHECK(texture_sampling_key(tcw, 0x2008a4edu) == texture_sampling_key(tcw, 0x9408a4edu));
+    // A different size or a different texture is a different key.
+    CHECK(texture_sampling_key(tcw, 0x2008a4edu) != texture_sampling_key(tcw, 0x2008a4e4u));
+    CHECK(texture_sampling_key(tcw, 0x2008a4edu) != texture_sampling_key(tcw + 1, 0x2008a4edu));
+    // Bit 6 is left free for the texture cache's "tiled" flag.
+    for (std::uint32_t tsp : {0u, 0xFFFFFFFFu, 0x2008a4edu}) CHECK((texture_sampling_key(tcw, tsp) & 0x40u) == 0);
+}
