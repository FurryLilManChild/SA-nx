diff --git a/render/include/dream/render/tsp.h b/render/include/dream/render/tsp.h
index d43c19a..e81b025 100644
--- a/render/include/dream/render/tsp.h
+++ b/render/include/dream/render/tsp.h
@@ -78,4 +78,15 @@ constexpr std::uint32_t tsp_sampler_key(std::uint32_t w) {
     return (w >> 13) & 0x3Fu;
 }
 
+// What identifies one way of sampling one texture: the control word, the TSP size bits (0 to 5)
+// and the sampler bits above. Polygons that share a texture can still ask for different clamping,
+// mirroring or filtering (a wall strip that repeats in V next to one that clamps), and a
+// descriptor set carries exactly one sampler, so the sampler bits have to be part of the key. Left
+// out, every polygon of a texture is drawn with whichever sampler was built first, and a strip
+// that wraps but gets a clamping sampler smears its edge texels across the polygon.
+constexpr std::uint64_t texture_sampling_key(std::uint32_t tcw, std::uint32_t tsp) {
+    return (static_cast<std::uint64_t>(tcw) << 32) | (tsp & 0x3Fu) |
+           (static_cast<std::uint64_t>(tsp_sampler_key(tsp)) << 8);
+}
+
 }  // namespace dream::render
